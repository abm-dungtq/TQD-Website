---
import { Font } from 'astro:assets';
import '../styles/global.css';
import type { Site } from '../lib/content';
import CommandPalette from '../components/CommandPalette.astro';
import ChatPanel from '../components/ChatPanel.astro';

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

interface Props {
  site: Site;
  title?: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article';
  /** Only set when a real 1:1 Markdown twin exists for this page (omitted on /404, etc.). */
  markdownPath?: string;
  ogImagePath?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  articleMeta?: ArticleMeta;
  /** Extra schema.org nodes for this page (Person, ProfilePage, Article, BreadcrumbList, WebApplication). */
  jsonLd?: Record<string, unknown>[];
}

const {
  site,
  title,
  description,
  path,
  ogType = 'website',
  markdownPath,
  ogImagePath = '/og.png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt,
  articleMeta,
  jsonLd = [],
} = Astro.props;

const { links, person, sections } = site;
const fullTitle = title ? `${title} · ${person.handle}` : `${person.name} (${person.handle})`;
const baseOrigin = Astro.url.origin || Astro.site?.origin || 'https://tqd.me';
const canonical = new URL(path, baseOrigin).href;
const origin = new URL('/', baseOrigin).href;
const ogImage = new URL(ogImagePath, baseOrigin).href;
const resolvedOgAlt = ogImageAlt || (title ? `${title} — ${person.name} (${person.handle})` : `${person.name} – ${person.role}`);
const markdownHref = markdownPath ? new URL(markdownPath, baseOrigin).href : undefined;
const current = path.replace(/^\//, '').split('/')[0];
const isHome = path === '/';
const primaryZalo = person.zalo || 'https://zalo.me/trinhquangdung';

const breadcrumbEntry = jsonLd.find((node) => node['@type'] === 'BreadcrumbList' && typeof node['@id'] === 'string');

const webPageNode: Record<string, unknown> = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  description,
  isPartOf: { '@id': `${origin}#website` },
  inLanguage: 'vi',
  ...(breadcrumbEntry ? { breadcrumb: { '@id': breadcrumbEntry['@id'] } } : {}),
};

const structured = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${origin}#website`, url: origin, name: person.handle, inLanguage: 'vi' },
    webPageNode,
    ...jsonLd,
  ],
};
// Escape "<" so no title or summary can close the script element.
const structuredJson = JSON.stringify(structured).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf7f1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={`${person.name} (${person.handle})`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={resolvedOgAlt} />
    {
      ogType === 'article' && articleMeta?.publishedTime && (
        <meta property="article:published_time" content={articleMeta.publishedTime} />
      )
    }
    {
      ogType === 'article' && articleMeta?.modifiedTime && (
        <meta property="article:modified_time" content={articleMeta.modifiedTime} />
      )
    }
    {
      ogType === 'article' && articleMeta?.author && (
        <meta property="article:author" content={articleMeta.author} />
      )
    }
    {
      ogType === 'article' &&
        articleMeta?.tags?.map((tag) => <meta property="article:tag" content={tag} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={structuredJson} />
    <Font
      cssVariable="--font-be-vietnam-pro"
      preload={[
        { weight: '400', subset: 'vietnamese' },
        { weight: '400', subset: 'latin' },
      ]}
    />
    <Font
      cssVariable="--font-cormorant"
      preload={[
        { weight: '600', subset: 'vietnamese' },
        { weight: '600', subset: 'latin' },
      ]}
    />
    <Font cssVariable="--font-jetbrains-mono" />
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      data-skip
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[2000] focus:rounded focus:bg-panel focus:px-3 focus:py-2"
      >Bỏ qua tới nội dung</a
    >
    <slot name="before" />
    <div data-fallback>
      <header class="site-header">
        <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-5 gap-y-1.5 px-5 py-3 lg:gap-x-7">
          <a href="/" class="site-brand">
            <span class="site-mark" aria-hidden="true">{person.initials}</span>
            <span class="display text-2xl">{person.handle}</span>
          </a>
          <nav
            aria-label="Các mục"
            class:list={[
              'site-nav -mx-1 order-last w-full gap-1 overflow-x-auto text-sm lg:order-none lg:w-auto',
              isHome ? 'hidden lg:flex' : 'flex',
            ]}
          >
            {
              sections.map((s) => (
                <a href={`/${s.id}`} aria-current={current === s.id ? 'page' : undefined} class="site-nav-link">
                  {s.title}
                </a>
              ))
            }
            <a href="/tai-video" aria-current={current === 'tai-video' ? 'page' : undefined} class="site-nav-link">
              Tải Video
            </a>
          </nav>
          <div class="ml-auto flex items-center gap-2">
            <a
              href={primaryZalo}
              target="_blank"
              rel="noopener noreferrer"
              class="hidden sm:inline-flex min-h-11 items-center rounded-full border border-champagne/60 bg-panel px-3.5 text-xs font-semibold text-accent-ink no-underline transition-colors hover:border-accent hover:bg-tint"
            >
              Tư vấn AI
            </a>
            <button type="button" class="cmdk-trigger gradient-hover" data-cmdk-open hidden>
              Tìm <kbd class="hidden sm:inline">⌘K</kbd>
            </button>
          </div>
        </div>
      </header>
      <main id="main" class="mx-auto max-w-5xl px-5 py-10 sm:py-16">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="mx-auto flex max-w-5xl flex-col gap-6 px-5 py-12 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="display text-2xl">{person.name}</p>
            <p class="mt-1 text-sm text-muted">{person.role}</p>
            <p class="mt-4 text-xs text-muted">© 2026 {person.name}.</p>
          </div>
          <ul class="flex flex-wrap gap-x-5 text-sm font-semibold">
            {
              links.map((l) => (
                <li>
                  <a href={l.href} rel="noopener" target={l.href.startsWith('http') ? '_blank' : undefined} class="site-footer-link">
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/quyen-rieng-tu" class="site-footer-link">Quyền riêng tư</a></li>
          </ul>
        </div>
      </footer>
    </div>
    <ChatPanel zalo={primaryZalo} />
    <CommandPalette />
    <script>
      import '../scripts/analytics-beacon.ts';
    </script>
  </body>
</html>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-paper) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
  }
  .site-brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.6rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .site-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--color-champagne);
    background: var(--color-tint);
    color: var(--color-accent-ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }
  /* On narrow/tablet screens the nav scrolls sideways; mask-image adapts to scroll position. */
  @media (width < 64rem) {
    .site-nav {
      padding-right: 1.25rem;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, #000 88%, transparent);
    }
    .site-nav[data-scroll-pos='middle'] {
      mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }
    .site-nav[data-scroll-pos='end'] {
      mask-image: linear-gradient(90deg, transparent, #000 10%);
    }
    .site-nav[data-scroll-pos='none'] {
      mask-image: none;
    }
  }
  .site-nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
    padding: 0 0.55rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 200ms var(--os-ease);
  }
  .site-header .cmdk-trigger {
    min-height: 44px;
    padding: 0 0.75rem;
  }
  .site-nav-link::after {
    content: '';
    position: absolute;
    inset: auto 0.55rem 0.15rem;
    height: 1.5px;
    background: var(--color-champagne);
    transform: scaleX(0);
    transition: transform 220ms var(--os-ease);
  }
  .site-nav-link:hover,
  .site-nav-link[aria-current='page'] {
    color: var(--color-ink);
    font-weight: 500;
  }
  .site-nav-link:hover::after,
  .site-nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .site-footer {
    border-top: 1px solid var(--color-line);
    background: linear-gradient(180deg, var(--color-paper), var(--color-tint));
  }
  .site-footer-link {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-accent);
    text-decoration: none;
  }
  .site-footer-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-champagne);
    text-underline-offset: 0.25em;
  }
</style>
