---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  /** Hide the menu (login page). */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const path = Astro.url.pathname;
const menu = [
  { href: '/admin', label: 'Tổng quan' },
  { href: '/admin/bai-viet', label: 'Bài viết' },
  { href: '/admin/media', label: 'Media' },
  { href: '/admin/ho-so', label: 'Hồ sơ' },
  { href: '/admin/muc/san-pham', label: 'Sản phẩm' },
  { href: '/admin/muc/dao-tao', label: 'Đào tạo' },
  { href: '/admin/muc/video', label: 'Video' },
  { href: '/admin/so-lieu', label: 'Số liệu' },
  { href: '/admin/lien-he', label: 'Liên hệ' },
  { href: '/admin/sao-luu', label: 'Sao lưu' },
  { href: '/admin/api-keys', label: 'API key' },
];
const active = (href: string) => (href === '/admin' ? path === '/admin' : path.startsWith(href));
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-be-vietnam-pro" />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body class="min-h-screen">
    {
      !bare && (
        <header class="border-b border-line bg-panel">
          <nav class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-2 px-5 py-3 text-sm">
            <a href="/" class="font-bold text-ink no-underline">
              tqd.io.vn
            </a>
            {menu.map((m) => (
              <a href={m.href} aria-current={active(m.href) ? 'page' : undefined} class="admin-nav">
                {m.label}
              </a>
            ))}
            <form method="post" action="/admin/logout" class="ml-auto">
              <button type="submit" class="admin-btn-ghost">
                Đăng xuất
              </button>
            </form>
          </nav>
        </header>
      )
    }
    <main class="mx-auto max-w-5xl px-5 py-8">
      <h1 class="mb-6 text-2xl font-bold">{title}</h1>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .admin-nav {
    color: var(--color-muted);
    text-decoration: none;
  }
  .admin-nav[aria-current='page'] {
    color: var(--color-ink);
    font-weight: 600;
  }
  .admin-form {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }
  .admin-form label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .admin-form input:not([type='checkbox']),
  .admin-form textarea,
  .admin-form select {
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-panel);
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-weight: 400;
  }
  .admin-form textarea {
    min-height: 6rem;
  }
  .admin-form .mono {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .admin-btn,
  .admin-btn-ghost,
  .admin-btn-danger {
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    font-weight: 600;
    cursor: pointer;
    justify-self: start;
  }
  .admin-btn {
    background: var(--color-accent);
    color: #fff;
  }
  .admin-btn-ghost {
    border: 1px solid var(--color-line);
    background: var(--color-panel);
  }
  .admin-btn-danger {
    background: #b91c1c;
    color: #fff;
  }
  .admin-ok,
  .admin-error {
    margin-bottom: 1rem;
    border-radius: 0.5rem;
    padding: 0.6rem 0.9rem;
  }
  .admin-ok {
    background: #dcfce7;
    color: #14532d;
  }
  .admin-error {
    background: #fee2e2;
    color: #7f1d1d;
    white-space: pre-line;
  }
  .admin-flag {
    margin-left: 0.5rem;
    border-radius: 9999px;
    background: #fef3c7;
    color: #78350f;
    padding: 0.1rem 0.5rem;
    font-size: 0.75rem;
  }
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .admin-table th,
  .admin-table td {
    border-bottom: 1px solid var(--color-line);
    padding: 0.5rem;
    text-align: left;
  }
</style>
