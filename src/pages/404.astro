---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite } from '../lib/content';

Astro.response.status = 404;
const site = await getSite(env.DB);
---

<BaseLayout site={site} title="Không tìm thấy trang" description="Trang này không tồn tại." path="/404">
  <h1 class="mb-3 text-3xl font-bold tracking-tight">Không tìm thấy trang</h1>
  <p class="mb-8 text-muted">Đường dẫn này không tồn tại. Về <a href="/">trang chủ</a> hoặc chọn một mục:</p>
  <ul class="grid gap-2 sm:grid-cols-2">
    {
      site.sections.map((s) => (
        <li>
          <a href={`/${s.id}`}>{s.title}</a>
          <span class="text-muted"> — {s.short}</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
