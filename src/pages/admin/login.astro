---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { cookieHeader, createSession } from '../../lib/auth';
import { verifyPassword } from '../../lib/password';
import { hit, reset } from '../../lib/rate-limit';
import { logSecurityEvent } from '../../lib/security-log';

let error = '';
let email = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const bucket = 'login:' + (Astro.request.headers.get('cf-connecting-ip') ?? 'local');
  const [ipLimit, globalLimit] = await Promise.all([
    hit(env.DB, bucket, 5, 900),
    hit(env.DB, 'login:global', 25, 900),
  ]);
  if (!ipLimit.allowed || !globalLimit.allowed) {
    const retryAfter = Math.max(ipLimit.retryAfter, globalLimit.retryAfter);
    await logSecurityEvent(
      'admin.login.rate_limited',
      { scope: !ipLimit.allowed ? 'ip' : 'global', retryAfter },
      Astro.request,
    );
    Astro.response.status = 429;
    error = `Sai quá nhiều lần. Thử lại sau ${Math.max(1, Math.ceil(retryAfter / 60))} phút.`;
  } else if (!env.ADMIN_PASSWORD_HASH) {
    Astro.response.status = 503;
    error = 'Chưa đặt mật khẩu admin.';
  } else {
    const passwordOk = await verifyPassword(password, env.ADMIN_PASSWORD_HASH);
    if (passwordOk && email.toLowerCase() === env.ADMIN_EMAIL.toLowerCase()) {
      await reset(env.DB, bucket);
      const token = await createSession(env.DB);
      await logSecurityEvent('admin.login.success', {}, Astro.request);
      return new Response(null, { status: 303, headers: { Location: '/admin', 'Set-Cookie': cookieHeader(token) } });
    }
    await logSecurityEvent('admin.login.failure', {}, Astro.request);
    Astro.response.status = 401;
    error = 'Sai email hoặc mật khẩu.';
  }
}
---

<AdminLayout title="Đăng nhập" bare>
  {error && <p class="admin-error" role="alert">{error}</p>}
  <form method="post" class="admin-form max-w-sm">
    <label>Email <input name="email" type="email" autocomplete="username" required value={email} /></label>
    <label>Mật khẩu <input name="password" type="password" autocomplete="current-password" required /></label>
    <button type="submit" class="admin-btn">Đăng nhập</button>
  </form>
</AdminLayout>
