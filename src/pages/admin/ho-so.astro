---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { checkLength, InputError, LIMITS, saveSetting } from '../../lib/admin-writes';
import { getSite, type Person } from '../../lib/content';

// Second line of defence; the middleware sets this only for a valid session.
if (!Astro.locals.admin) return new Response('Unauthorized', { status: 401 });

const site = await getSite(env.DB);
const DEFAULT_PORTRAIT = { portrait: '/img/portrait-480.webp', portraitSmall: '/img/portrait-240.webp' };
const { results: images } = await env.DB.prepare(
  "SELECT key, alt FROM media WHERE content_type LIKE 'image/%' ORDER BY created_at DESC",
).all<{ key: string; alt: string }>();
let person: Person = site.person;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (name: string) => String(form.get(name) ?? '').trim();
  const next: Person = {
    ...site.person,
    name: text('name'),
    handle: text('handle'),
    initials: text('initials'),
    role: text('role'),
    intro: text('intro'),
    focus: text('focus')
      .split(/\r?\n/)
      .map((l) => l.trim())
      .filter(Boolean),
    email: text('email'),
    zalo: text('zalo'),
    portraitAlt: text('portraitAlt'),
  };
  const portraitKey = text('portraitKey');
  if (!portraitKey) Object.assign(next, DEFAULT_PORTRAIT);
  else if (images.some((m) => m.key === portraitKey)) next.portrait = next.portraitSmall = `/media/${portraitKey}`;
  try {
    if (!next.name) throw new InputError('Cần tên.');
    if (next.zalo && !/^https:\/\/zalo\.me\/[\w.-]+$/.test(next.zalo)) {
      throw new InputError('Zalo cần dạng https://zalo.me/<tên hoặc số>.');
    }
    checkLength('Vai trò', next.role, LIMITS.title);
    checkLength('Giới thiệu', next.intro, LIMITS.intro);
    await saveSetting(env.DB, 'person', next);
    return Astro.redirect('/admin/ho-so?ok=1', 303);
  } catch (e) {
    if (!(e instanceof InputError)) throw e;
    Astro.response.status = 400;
    error = e.message;
    person = next;
  }
}
const saved = Astro.url.searchParams.has('ok');
---

<AdminLayout title="Hồ sơ">
  {saved && <p class="admin-ok">Đã lưu.</p>}
  {error && <p class="admin-error" role="alert">{error}</p>}
  <form method="post" class="admin-form">
    <label>Tên <input name="name" value={person.name} required /></label>
    <label>Tên gọi <input name="handle" value={person.handle} /></label>
    <label>Chữ viết tắt <input name="initials" value={person.initials} /></label>
    <label>Vai trò <input name="role" value={person.role} maxlength={LIMITS.title} /></label>
    <label>Giới thiệu <textarea name="intro" maxlength={LIMITS.intro}>{person.intro}</textarea></label>
    <label>Trọng tâm (mỗi dòng một ý) <textarea name="focus">{person.focus.join('\n')}</textarea></label>
    <label>Email <input name="email" type="email" value={person.email} /></label>
    <label>Zalo <input name="zalo" value={person.zalo} /></label>
    <label>Ảnh chân dung
      <select name="portraitKey">
        <option value="">Ảnh mặc định</option>
        {images.map((m) => <option value={m.key} selected={person.portrait === `/media/${m.key}`}>{m.alt || m.key}</option>)}
      </select>
    </label>
    <label>Mô tả ảnh chân dung <input name="portraitAlt" value={person.portraitAlt} /></label>
    <button type="submit" class="admin-btn">Lưu</button>
  </form>
</AdminLayout>
