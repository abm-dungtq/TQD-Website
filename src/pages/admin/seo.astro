---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  type BriefStatus,
  createBriefFromKeyword,
  listDailyBriefQueue,
  normalizePillar,
  prioritizeBrief,
  resolveBriefForAgent,
  seedDailyBriefsAndKeywords,
  toggleBriefSkip,
} from '../../lib/seo/briefs';
import { PILLAR_LABELS, SEO_PILLARS } from '../../lib/seo/daily-catalog';
import {
  getGscAuthState,
  submitSitemapToGsc,
  syncGscSearchAnalytics,
} from '../../lib/seo/gsc-client';
import {
  classifyVietnameseIntent,
  type KeywordResearchResult,
  researchKeywords,
} from '../../lib/seo/keyword-research';
import {
  deleteSeoKeyword,
  loadSeoDashboard,
  normalizeIntent,
  normalizePriority,
  normalizeStatus,
  SEO_INTENTS,
  SEO_PRIORITIES,
  SEO_STATUSES,
  type SeoIntent,
  type SeoKeywordInput,
  type SeoPriority,
  type SeoStatus,
  updateSeoKeyword,
  upsertSeoKeywords,
} from '../../lib/seo/store';

if (!Astro.locals.admin) return new Response('Unauthorized', { status: 401 });

const INTENT_LABELS: Record<SeoIntent, string> = {
  informational: 'Tìm hiểu',
  commercial: 'So sánh & Đánh giá',
  transactional: 'Mua & Dùng ngay',
  navigational: 'Tìm thương hiệu',
};

const PRIORITY_LABELS: Record<SeoPriority, string> = {
  high: 'Cao',
  medium: 'Trung bình',
  low: 'Thấp',
};

const STATUS_LABELS: Record<SeoStatus, string> = {
  idea: 'Ý tưởng',
  planned: 'Đã lên lịch',
  drafting: 'Đang viết nháp',
  published: 'Đã đăng',
  archived: 'Lưu trữ',
};

const BRIEF_STATUS_LABELS: Record<BriefStatus, string> = {
  queued: 'Chờ Agent viết',
  writing: 'Agent đang viết',
  published: 'Đã đăng',
  skipped: 'Tạm bỏ qua',
};

const gscState = getGscAuthState(env);

function buildRedirectUrl(
  baseQuery: {
    q?: string;
    range?: number;
    status?: string;
    priority?: string;
    filter?: string;
    pillar?: string;
    bstatus?: string;
  },
  extra: Record<string, string>,
): string {
  const sp = new URLSearchParams();
  if (baseQuery.q) sp.set('q', baseQuery.q);
  if (baseQuery.range && baseQuery.range !== 28) sp.set('range', String(baseQuery.range));
  if (baseQuery.status && baseQuery.status !== 'all') sp.set('status', baseQuery.status);
  if (baseQuery.priority && baseQuery.priority !== 'all') sp.set('priority', baseQuery.priority);
  if (baseQuery.filter) sp.set('filter', baseQuery.filter);
  if (baseQuery.pillar && baseQuery.pillar !== 'all') sp.set('pillar', baseQuery.pillar);
  if (baseQuery.bstatus && baseQuery.bstatus !== 'all') sp.set('bstatus', baseQuery.bstatus);
  for (const [k, v] of Object.entries(extra)) {
    if (v) sp.set(k, v);
  }
  const qs = sp.toString();
  return qs ? `/admin/seo?${qs}` : '/admin/seo';
}

let actionError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '').trim();
  const returnCtx = {
    q: String(form.get('_q') ?? '').trim(),
    range: Number(form.get('_range') ?? '28') || 28,
    status: String(form.get('_status') ?? 'all').trim(),
    priority: String(form.get('_priority') ?? 'all').trim(),
    filter: String(form.get('_filter') ?? '').trim(),
    pillar: String(form.get('_pillar') ?? 'all').trim(),
    bstatus: String(form.get('_bstatus') ?? 'all').trim(),
  };

  if (action === 'seed_queue' || action === 'seed_briefs') {
    const seeded = await seedDailyBriefsAndKeywords(env.DB);
    return Astro.redirect(
      buildRedirectUrl(returnCtx, {
        ok: '1',
        notice: 'seeded',
        count: String(seeded.briefsSeeded),
      }),
      303,
    );
  }

  if (action === 'prioritize_brief') {
    const id = Number(form.get('id'));
    const ok = await prioritizeBrief(env.DB, id);
    if (!ok) {
      actionError = 'Không thể đưa đề bài này lên đầu hàng đợi (có thể bài đã đăng).';
      Astro.response.status = 400;
    } else {
      return Astro.redirect(buildRedirectUrl(returnCtx, { ok: '1', notice: 'brief_prioritized' }), 303);
    }
  } else if (action === 'toggle_brief_skip') {
    const id = Number(form.get('id'));
    const ok = await toggleBriefSkip(env.DB, id);
    if (!ok) {
      actionError = 'Không thể đổi trạng thái đề bài này.';
      Astro.response.status = 400;
    } else {
      return Astro.redirect(buildRedirectUrl(returnCtx, { ok: '1', notice: 'brief_toggled' }), 303);
    }
  } else if (action === 'create_brief_from_kw') {
    const keyword = String(form.get('keyword') ?? '').trim();
    const pillar = normalizePillar(String(form.get('pillar') ?? 'ai-agent-sme'));
    const slug = String(form.get('targetSlug') ?? '').trim();
    const title = String(form.get('suggestedTitle') ?? '').trim();
    if (!keyword || keyword.length > 160) {
      actionError = 'Vui lòng nhập từ khóa hợp lệ để tạo đề bài cho Agent.';
      Astro.response.status = 400;
    } else {
      await createBriefFromKeyword(env.DB, { keyword, pillar, slug, title });
      return Astro.redirect(buildRedirectUrl(returnCtx, { ok: '1', notice: 'brief_created' }), 303);
    }
  } else if (action === 'sync_gsc') {
    try {
      const result = await syncGscSearchAnalytics(env, { days: returnCtx.range });
      return Astro.redirect(
        buildRedirectUrl(returnCtx, { ok: '1', notice: 'gsc_synced', count: String(result.rowsSynced) }),
        303,
      );
    } catch (err) {
      actionError = err instanceof Error ? err.message : 'Không thể đồng bộ Google Search Console.';
      Astro.response.status = 400;
    }
  } else if (action === 'submit_sitemap') {
    try {
      await submitSitemapToGsc(env, 'https://tqd.me/sitemap.xml');
      return Astro.redirect(buildRedirectUrl(returnCtx, { ok: '1', notice: 'sitemap_submitted' }), 303);
    } catch (err) {
      actionError = err instanceof Error ? err.message : 'Không thể gửi sitemap lên Google Search Console.';
      Astro.response.status = 400;
    }
  } else if (action === 'save_keyword') {
    const keyword = String(form.get('keyword') ?? '').trim();
    if (!keyword || keyword.length > 160) {
      actionError = 'Vui lòng nhập từ khóa hợp lệ (1–160 ký tự).';
      Astro.response.status = 400;
    } else {
      const rawIntent = String(form.get('intent') ?? '').trim();
      const intent = SEO_INTENTS.includes(rawIntent as SeoIntent)
        ? (rawIntent as SeoIntent)
        : classifyVietnameseIntent(keyword);
      const priority = normalizePriority(String(form.get('priority') ?? 'medium'), 'medium');
      const status = normalizeStatus(String(form.get('status') ?? 'planned'), 'planned');
      const cluster = String(form.get('cluster') ?? '').trim();
      const targetSlug = String(form.get('targetSlug') ?? '').trim() || null;
      const suggestedTitle = String(form.get('suggestedTitle') ?? '').trim();
      const notes = String(form.get('notes') ?? '').trim();
      const volume = form.get('volume') ? Number(form.get('volume')) : null;
      const difficulty = form.get('difficulty') ? Number(form.get('difficulty')) : null;
      const cpc = form.get('cpc') ? Number(form.get('cpc')) : null;

      await upsertSeoKeywords(env.DB, [
        {
          keyword,
          cluster,
          intent,
          priority,
          status,
          volume: volume !== null && Number.isFinite(volume) ? volume : null,
          difficulty: difficulty !== null && Number.isFinite(difficulty) ? difficulty : null,
          cpc: cpc !== null && Number.isFinite(cpc) ? cpc : null,
          source: String(form.get('source') ?? 'admin').trim() || 'admin',
          targetSlug,
          suggestedTitle,
          notes,
        },
      ]);
      return Astro.redirect(buildRedirectUrl(returnCtx, { ok: '1', notice: 'kw_saved' }), 303);
    }
  } else if (action === 'save_batch') {
    const rawJson = String(form.get('batchJson') ?? '').trim();
    let parsed: SeoKeywordInput[] = [];
    try {
      const list = JSON.parse(rawJson);
      if (Array.isArray(list)) parsed = list;
    } catch {
      parsed = [];
    }
    if (parsed.length === 0) {
      actionError = 'Không có từ khóa mới nào trong danh sách để lưu.';
      Astro.response.status = 400;
    } else {
      const savedCount = await upsertSeoKeywords(
        env.DB,
        parsed.map((item) => ({
          ...item,
          status: item.status ?? 'planned',
          source: item.source ?? 'keyword-lab',
        })),
      );
      return Astro.redirect(
        buildRedirectUrl(returnCtx, { ok: '1', notice: 'batch_saved', count: String(savedCount) }),
        303,
      );
    }
  } else if (action === 'update_keyword') {
    const id = Number(form.get('id'));
    const ok = await updateSeoKeyword(env.DB, id, {
      status: normalizeStatus(String(form.get('status') ?? 'idea')),
      priority: normalizePriority(String(form.get('priority') ?? 'medium')),
      intent: normalizeIntent(String(form.get('intent') ?? 'informational')),
      cluster: String(form.get('cluster') ?? '').trim(),
      targetSlug: String(form.get('targetSlug') ?? '').trim() || null,
    });
    if (!ok) {
      actionError = 'Không tìm thấy từ khóa để cập nhật.';
      Astro.response.status = 404;
    } else {
      return Astro.redirect(buildRedirectUrl(returnCtx, { ok: '1', notice: 'kw_updated' }), 303);
    }
  } else if (action === 'delete_keyword') {
    const id = Number(form.get('id'));
    await deleteSeoKeyword(env.DB, id);
    return Astro.redirect(buildRedirectUrl(returnCtx, { ok: '1', notice: 'kw_deleted' }), 303);
  }
}

const sp = Astro.url.searchParams;
const q = String(sp.get('q') ?? '').trim();
const rawRange = Number(sp.get('range') ?? '28');
const rangeDays = [7, 28, 90].includes(rawRange) ? rawRange : 28;
const statusFilter = String(sp.get('status') ?? 'all').trim();
const priorityFilter = String(sp.get('priority') ?? 'all').trim();
const textFilter = String(sp.get('filter') ?? '').trim();
const pillarFilter = String(sp.get('pillar') ?? 'all').trim();
const briefStatusFilter = String(sp.get('bstatus') ?? 'queued').trim();

const notice = sp.get('notice');
const noticeCount = Number(sp.get('count') ?? '0');

const [dash, briefQueue, research] = await Promise.all([
  loadSeoDashboard(env.DB, {
    siteUrl: gscState.siteUrl,
    rangeDays,
    statusFilter,
    priorityFilter,
    searchFilter: textFilter,
  }),
  listDailyBriefQueue(env.DB, {
    pillar: pillarFilter,
    status: briefStatusFilter,
  }),
  q
    ? researchKeywords(env.DB, q, {
        reviewWebApiKey: env.REVIEWWEB_API_KEY,
        siteUrl: gscState.siteUrl,
      })
    : Promise.resolve<KeywordResearchResult | null>(null),
]);

const nextBriefResolved = briefQueue.nextBrief
  ? await resolveBriefForAgent(env.DB, briefQueue.nextBrief)
  : null;

const newOppBatch = research
  ? research.items
      .filter((i) => i.coverage === 'new_opportunity')
      .map((i) => ({
        keyword: i.keyword,
        cluster: `Nghiên cứu: ${research.seed}`,
        intent: i.intent,
        priority: i.priority,
        status: 'planned' as const,
        volume: i.volume,
        difficulty: i.difficulty,
        cpc: i.cpc,
        source: 'keyword-lab',
        targetSlug: i.suggestedSlug,
        suggestedTitle: i.keyword,
      }))
  : [];

const presetTopics = [
  'AI Agent cho doanh nghiệp',
  'Veo 3 Ultra làm video quảng cáo',
  'tải video tiktok không logo',
  'Vibe Code không cần biết lập trình',
  'tối ưu GEO cho ChatGPT Search',
];

const fmtNum = (n: number) => Math.round(n).toLocaleString('vi-VN');
const fmtPct = (v: number) => `${(v * 100).toFixed(1)}%`;

const noticeMessages: Record<string, string> = {
  seeded: `Đã đồng bộ ${noticeCount} đề bài chuẩn SEO+GEO (5 trụ cột) cùng toàn bộ từ khóa mục tiêu vào hệ thống.`,
  brief_prioritized: 'Đã đưa đề bài lên vị trí số 1 để Agent viết ở lượt tiếp theo.',
  brief_toggled: 'Đã cập nhật trạng thái đề bài trong hàng đợi Agent.',
  brief_created: 'Đã tạo đề bài mới và đặt lên đầu hàng đợi cho Agent.',
  gsc_synced: `Đã đồng bộ ${noticeCount} dòng dữ liệu tìm kiếm từ Google Search Console.`,
  sitemap_submitted: 'Đã gửi https://tqd.me/sitemap.xml lên Google Search Console.',
  kw_saved: 'Đã lưu từ khóa vào giỏ kế hoạch.',
  batch_saved: `Đã lưu ${noticeCount} từ khóa cơ hội mới vào giỏ kế hoạch.`,
  kw_updated: 'Đã cập nhật trạng thái từ khóa.',
  kw_deleted: 'Đã xoá từ khóa khỏi giỏ kế hoạch.',
};
const noticeText = notice ? noticeMessages[notice] ?? 'Đã lưu thay đổi.' : '';

const ctxParams = {
  q,
  range: rangeDays,
  status: statusFilter,
  priority: priorityFilter,
  filter: textFilter,
  pillar: pillarFilter,
  bstatus: briefStatusFilter,
};
---

<AdminLayout title="SEO, GEO & Hệ thống từ khóa Agent">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-line bg-panel px-4 py-3 text-sm">
    <div class="flex flex-wrap items-center gap-3">
      <span>
        Search Console: <strong>{gscState.siteUrl}</strong>
        {gscState.configured ? (
          <span class="admin-flag">Đã nối tự động ({gscState.mode === 'service_account' ? 'Service Account' : 'OAuth2'})</span>
        ) : (
          <span class="admin-flag">Chưa gắn khóa đồng bộ tự động</span>
        )}
      </span>
      <span>
        ReviewWeb API:
        {env.REVIEWWEB_API_KEY?.trim() ? (
          <span class="admin-flag">Đã kết nối (có Lượt tìm & Độ khó)</span>
        ) : (
          <span class="admin-flag">Đang dùng Google Gợi ý VN</span>
        )}
      </span>
    </div>
    <div class="flex flex-wrap gap-3 text-xs">
      <a href="/sitemap.xml" target="_blank" rel="noopener">sitemap.xml</a>
      <a href="/robots.txt" target="_blank" rel="noopener">robots.txt</a>
      <a href="/llms.txt" target="_blank" rel="noopener">llms.txt</a>
      <a href="https://search.google.com/search-console" target="_blank" rel="noopener">Mở Google Search Console ↗</a>
    </div>
  </div>

  {noticeText && <p class="admin-ok">{noticeText}</p>}
  {actionError && <p class="admin-error" role="alert">{actionError}</p>}

  {/* Khối 0: Hàng đợi Đề bài SEO + GEO hàng ngày cho Agent */}
  <section class="mb-8 rounded-lg border border-line bg-panel p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold">0. Hàng đợi Đề bài SEO & GEO Hàng ngày cho Agent</h2>
        <p class="text-xs text-muted">
          Còn <strong>{briefQueue.counts.queued} bài chờ viết</strong> (đủ Agent tự đăng hàng ngày trong {briefQueue.counts.queued} ngày) · Đang viết: {briefQueue.counts.writing} · Đã đăng: {briefQueue.counts.published} · Tạm bỏ qua: {briefQueue.counts.skipped}
        </p>
      </div>
      <form method="post" action="/admin/seo">
        <input type="hidden" name="_action" value="seed_briefs" />
        <input type="hidden" name="_q" value={q} />
        <input type="hidden" name="_range" value={String(rangeDays)} />
        <input type="hidden" name="_pillar" value={pillarFilter} />
        <input type="hidden" name="_bstatus" value={briefStatusFilter} />
        <button type="submit" class="admin-btn text-xs">
          Nạp & Đồng bộ 45 Đề bài 5 Trụ cột
        </button>
      </form>
    </div>

    {nextBriefResolved && (
      <div class="mb-5 rounded-lg border border-champagne/60 bg-tint p-4 text-sm">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded bg-ink px-2 py-0.5 text-xs font-semibold text-paper">
              Đề bài tiếp theo Agent sẽ viết (08:00 sáng)
            </span>
            <span class="rounded border border-line bg-panel px-2 py-0.5 text-xs font-semibold">
              {nextBriefResolved.pillarLabel}
            </span>
          </div>
          <a
            href={`/admin/bai-viet/moi?title=${encodeURIComponent(nextBriefResolved.title)}&slug=${encodeURIComponent(nextBriefResolved.slug)}&kw=${encodeURIComponent(nextBriefResolved.primaryKeyword)}&summary=${encodeURIComponent(nextBriefResolved.answerCapsuleHint)}&sections=${encodeURIComponent(nextBriefResolved.sections.join('||'))}`}
            class="text-xs font-semibold"
          >
            Viết tay bài này ngay →
          </a>
        </div>
        <p class="text-base font-bold text-ink">{nextBriefResolved.title}</p>
        <p class="mt-1 text-xs text-muted">
          Slug: <code>/bai-viet/{nextBriefResolved.slug}</code> · CTA đích: <code>{nextBriefResolved.ctaPath}</code> · Từ khóa chính: <strong>{nextBriefResolved.primaryKeyword}</strong>
        </p>
        <div class="mt-3 grid gap-3 text-xs sm:grid-cols-2">
          <div class="rounded border border-line bg-panel p-2.5">
            <p class="font-semibold">Từ khóa phụ & Câu hỏi AI (GEO)</p>
            <p class="mt-1 text-muted">{nextBriefResolved.secondaryKeywords.join(', ')}</p>
            {nextBriefResolved.geoQuestions.length > 0 && (
              <p class="mt-1"><strong>AI Prompt:</strong> {nextBriefResolved.geoQuestions[0]}</p>
            )}
          </div>
          <div class="rounded border border-line bg-panel p-2.5">
            <p class="font-semibold">Bằng chứng E-E-A-T & Liên kết nội bộ sống ({nextBriefResolved.liveInternalLinks.length})</p>
            <p class="mt-1 text-muted">{nextBriefResolved.eeatAnchor}</p>
            {nextBriefResolved.liveInternalLinks.length > 0 && (
              <p class="mt-1">
                <strong>Link sẵn sàng:</strong>{' '}
                {nextBriefResolved.liveInternalLinks.map((l) => l.slug).join(', ')}
              </p>
            )}
          </div>
        </div>
      </div>
    )}

    <div class="mb-4 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex flex-wrap gap-1.5">
        <a
          href={buildRedirectUrl(ctxParams, { pillar: 'all' })}
          class={`rounded-md px-2.5 py-1.5 font-semibold no-underline ${
            pillarFilter === 'all' ? 'bg-ink text-paper' : 'border border-line text-ink'
          }`}
        >
          Mọi trụ cột ({briefQueue.counts.total})
        </a>
        {SEO_PILLARS.map((p) => {
          const stat = briefQueue.byPillar[p];
          return (
            <a
              href={buildRedirectUrl(ctxParams, { pillar: p })}
              class={`rounded-md px-2.5 py-1.5 font-semibold no-underline ${
                pillarFilter === p ? 'bg-ink text-paper' : 'border border-line text-ink'
              }`}
            >
              {PILLAR_LABELS[p]} ({stat.queued} chờ / {stat.published} xong)
            </a>
          );
        })}
      </div>

      <div class="flex flex-wrap gap-1.5">
        {(['queued', 'writing', 'published', 'skipped', 'all'] as const).map((st) => (
          <a
            href={buildRedirectUrl(ctxParams, { bstatus: st })}
            class={`rounded-md px-2.5 py-1 font-semibold no-underline ${
              briefStatusFilter === st ? 'bg-accent text-paper' : 'border border-line text-ink'
            }`}
          >
            {st === 'all' ? 'Tất cả' : BRIEF_STATUS_LABELS[st]}
          </a>
        ))}
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Thứ tự & Trụ cột</th>
            <th>Đề bài & Từ khóa SEO+GEO</th>
            <th>CTA đích</th>
            <th>Trạng thái</th>
            <th>Điều phối</th>
          </tr>
        </thead>
        <tbody>
          {briefQueue.items.length === 0 ? (
            <tr>
              <td colspan="5" class="text-xs text-muted">
                Chưa có đề bài nào trong nhóm lọc này. Bấm “Nạp & Đồng bộ 45 Đề bài 5 Trụ cột” ở trên để khởi tạo hàng đợi.
              </td>
            </tr>
          ) : (
            briefQueue.items.slice(0, 25).map((b) => {
              const draftLink = `/admin/bai-viet/moi?title=${encodeURIComponent(b.title)}&slug=${encodeURIComponent(b.slug)}&kw=${encodeURIComponent(b.primaryKeyword)}&summary=${encodeURIComponent(b.answerCapsuleHint)}&sections=${encodeURIComponent(b.sections.join('||'))}`;
              return (
                <tr>
                  <td class="align-top text-xs">
                    <div class="font-mono font-semibold">#{b.dayOrder}</div>
                    <div class="mt-0.5 text-muted">{b.pillarLabel}</div>
                  </td>
                  <td class="align-top">
                    <div class="font-semibold">{b.title}</div>
                    <div class="mt-0.5 text-xs text-muted">
                      Từ khóa chính: <strong>{b.primaryKeyword}</strong> · Slug: <code>{b.slug}</code>
                    </div>
                    {b.secondaryKeywords.length > 0 && (
                      <div class="mt-0.5 text-xs text-muted">
                        Phụ: {b.secondaryKeywords.slice(0, 3).join(', ')}
                      </div>
                    )}
                  </td>
                  <td class="align-top text-xs">
                    <code>{b.ctaPath}</code>
                  </td>
                  <td class="align-top text-xs">
                    <span class="rounded bg-tint px-2 py-0.5 font-semibold">
                      {BRIEF_STATUS_LABELS[b.status]}
                    </span>
                    {b.claimedBy && b.status === 'writing' && (
                      <div class="mt-1 text-muted">Agent: {b.claimedBy}</div>
                    )}
                  </td>
                  <td class="align-top text-xs">
                    <div class="flex flex-wrap gap-2">
                      {b.status === 'published' ? (
                        <a href={`/bai-viet/${b.slug}`} target="_blank" rel="noopener" class="font-semibold">
                          Xem bài ↗
                        </a>
                      ) : (
                        <>
                          <form method="post" action="/admin/seo">
                            <input type="hidden" name="_action" value="prioritize_brief" />
                            <input type="hidden" name="id" value={String(b.id)} />
                            <input type="hidden" name="_q" value={q} />
                            <input type="hidden" name="_range" value={String(rangeDays)} />
                            <input type="hidden" name="_pillar" value={pillarFilter} />
                            <input type="hidden" name="_bstatus" value={briefStatusFilter} />
                            <button type="submit" class="rounded border border-line bg-paper px-2 py-1 font-semibold hover:border-accent">
                              Đưa lên đầu
                            </button>
                          </form>
                          <form method="post" action="/admin/seo">
                            <input type="hidden" name="_action" value="toggle_brief_skip" />
                            <input type="hidden" name="id" value={String(b.id)} />
                            <input type="hidden" name="_q" value={q} />
                            <input type="hidden" name="_range" value={String(rangeDays)} />
                            <input type="hidden" name="_pillar" value={pillarFilter} />
                            <input type="hidden" name="_bstatus" value={briefStatusFilter} />
                            <button type="submit" class="rounded border border-line bg-paper px-2 py-1 text-muted hover:border-accent">
                              {b.status === 'skipped' ? 'Khôi phục' : 'Bỏ qua'}
                            </button>
                          </form>
                          <a href={draftLink} class="inline-flex items-center font-semibold">
                            Viết tay →
                          </a>
                        </>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
    {briefQueue.items.length > 25 && (
      <p class="mt-2 text-xs text-muted">
        Đang hiện 25 đề bài đầu tiên trong tổng {briefQueue.items.length} đề bài khớp bộ lọc (lọc theo từng trụ cột ở trên để xem chi tiết).
      </p>
    )}
  </section>

  {/* Khối 1: Phòng nghiên cứu từ khóa (/ak-seo Keyword Lab) */}
  <section class="mb-8 rounded-lg border border-line bg-panel p-5">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-lg font-bold">1. Tìm kiếm và nghiên cứu từ khóa (/ak-seo)</h2>
      <span class="text-xs text-muted">
        Lấy gợi ý thực tế người Việt đang gõ trên Google và đối chiếu với bài viết đang có trên tqd.me
      </span>
    </div>

    <form method="get" action="/admin/seo" class="flex flex-wrap gap-2">
      <input type="hidden" name="range" value={String(rangeDays)} />
      {statusFilter !== 'all' && <input type="hidden" name="status" value={statusFilter} />}
      {priorityFilter !== 'all' && <input type="hidden" name="priority" value={priorityFilter} />}
      {pillarFilter !== 'all' && <input type="hidden" name="pillar" value={pillarFilter} />}
      {briefStatusFilter !== 'queued' && <input type="hidden" name="bstatus" value={briefStatusFilter} />}
      <input
        type="search"
        name="q"
        value={q}
        required
        maxlength="120"
        placeholder="Nhập chủ đề muốn phát triển nội dung (vd: AI Agent cho doanh nghiệp)..."
        class="min-h-11 flex-1 rounded-lg border border-line bg-paper px-3 py-2 text-sm"
      />
      <button type="submit" class="admin-btn">Tìm từ khóa gợi ý</button>
    </form>

    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-muted">Gợi ý nhanh:</span>
      {
        presetTopics.map((topic) => (
          <a
            href={buildRedirectUrl(ctxParams, { q: topic })}
            class="rounded-full border border-line bg-tint px-3 py-1 text-ink no-underline hover:border-accent"
          >
            {topic}
          </a>
        ))
      }
    </div>

    {
      research && (
        <div class="mt-5 border-t border-line pt-4">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-sm font-semibold">
                Kết quả cho “{research.seed}”: tìm thấy {research.items.length} từ khóa
              </p>
              <p class="text-xs text-muted">
                Nguồn: {research.sourcesUsed.join(' · ') || 'Cục bộ'}
                {research.reviewWebNote && ` · ${research.reviewWebNote}`}
              </p>
            </div>
            {newOppBatch.length > 0 && (
              <form method="post" action="/admin/seo">
                <input type="hidden" name="_action" value="save_batch" />
                <input type="hidden" name="_q" value={q} />
                <input type="hidden" name="_range" value={String(rangeDays)} />
                <input type="hidden" name="_status" value={statusFilter} />
                <input type="hidden" name="_priority" value={priorityFilter} />
                <input type="hidden" name="_pillar" value={pillarFilter} />
                <input type="hidden" name="_bstatus" value={briefStatusFilter} />
                <input type="hidden" name="batchJson" value={JSON.stringify(newOppBatch)} />
                <button type="submit" class="admin-btn text-xs">
                  + Lưu {newOppBatch.length} cơ hội mới vào giỏ
                </button>
              </form>
            )}
          </div>

          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Từ khóa</th>
                  <th>Mục đích</th>
                  <th>Lượt tìm / Độ khó</th>
                  <th>Trên Google (GSC)</th>
                  <th>Hiện trạng trên tqd.me</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                {research.items.map((item) => {
                  const draftHref = `/admin/bai-viet/moi?title=${encodeURIComponent(item.keyword)}&slug=${encodeURIComponent(item.suggestedSlug)}&kw=${encodeURIComponent(item.keyword)}`;
                  return (
                    <tr>
                      <td>
                        <div class="font-semibold">{item.keyword}</div>
                        <div class="text-xs text-muted">{item.sources.join(' · ')}</div>
                      </td>
                      <td>
                        <span class="rounded bg-tint px-2 py-0.5 text-xs">{INTENT_LABELS[item.intent]}</span>
                      </td>
                      <td class="text-xs">
                        {item.volume !== null || item.difficulty !== null ? (
                          <div>
                            <div>Lượt tìm: <strong>{item.volume !== null ? fmtNum(item.volume) : '—'}</strong></div>
                            <div>Độ khó: <strong>{item.difficulty !== null ? `${item.difficulty}/100` : '—'}</strong></div>
                          </div>
                        ) : (
                          <span class="text-muted">Chưa nối ReviewWeb</span>
                        )}
                      </td>
                      <td class="text-xs">
                        {item.gscImpressions !== null ? (
                          <div>
                            <div>{fmtNum(item.gscImpressions)} lượt hiện</div>
                            <div class="text-muted">Vị trí {item.gscPosition} · {item.gscClicks ?? 0} click</div>
                          </div>
                        ) : (
                          <span class="text-muted">—</span>
                        )}
                      </td>
                      <td class="text-xs">
                        {item.coverage === 'covered_article' && item.matchedArticle ? (
                          <div>
                            <span class="rounded bg-emerald-100 px-2 py-0.5 text-emerald-900">Đã có bài</span>
                            <div class="mt-1">
                              <a href={`/bai-viet/${item.matchedArticle.slug}`} target="_blank" rel="noopener">
                                {item.matchedArticle.title}
                              </a>
                            </div>
                          </div>
                        ) : item.coverage === 'covered_tool' && item.matchedToolPath ? (
                          <div>
                            <span class="rounded bg-sky-100 px-2 py-0.5 text-sky-900">Trang công cụ</span>
                            <div class="mt-1">
                              <a href={item.matchedToolPath} target="_blank" rel="noopener">
                                <code>{item.matchedToolPath}</code>
                              </a>
                            </div>
                          </div>
                        ) : item.coverage === 'in_backlog' ? (
                          <span class="rounded bg-amber-100 px-2 py-0.5 text-amber-900">
                            Trong giỏ ({STATUS_LABELS[item.backlogStatus ?? 'idea']})
                          </span>
                        ) : (
                          <span class="rounded bg-amber-50 px-2 py-0.5 font-semibold text-amber-900">
                            Cơ hội mới
                          </span>
                        )}
                      </td>
                      <td>
                        <div class="flex flex-wrap items-center gap-2">
                          {!item.inBacklog && (
                            <form method="post" action="/admin/seo">
                              <input type="hidden" name="_action" value="save_keyword" />
                              <input type="hidden" name="_q" value={q} />
                              <input type="hidden" name="_range" value={String(rangeDays)} />
                              <input type="hidden" name="_status" value={statusFilter} />
                              <input type="hidden" name="_priority" value={priorityFilter} />
                              <input type="hidden" name="_pillar" value={pillarFilter} />
                              <input type="hidden" name="_bstatus" value={briefStatusFilter} />
                              <input type="hidden" name="keyword" value={item.keyword} />
                              <input type="hidden" name="intent" value={item.intent} />
                              <input type="hidden" name="priority" value={item.priority} />
                              <input type="hidden" name="status" value="planned" />
                              <input type="hidden" name="cluster" value={`Nghiên cứu: ${research.seed}`} />
                              <input type="hidden" name="targetSlug" value={item.matchedArticle?.slug ?? item.suggestedSlug} />
                              <input type="hidden" name="suggestedTitle" value={item.keyword} />
                              <input type="hidden" name="source" value="keyword-lab" />
                              {item.volume !== null && <input type="hidden" name="volume" value={String(item.volume)} />}
                              {item.difficulty !== null && <input type="hidden" name="difficulty" value={String(item.difficulty)} />}
                              {item.cpc !== null && <input type="hidden" name="cpc" value={String(item.cpc)} />}
                              <button type="submit" class="admin-btn-ghost text-xs">+ Lưu vào giỏ</button>
                            </form>
                          )}
                          {!item.matchedArticle && (
                            <form method="post" action="/admin/seo">
                              <input type="hidden" name="_action" value="create_brief_from_kw" />
                              <input type="hidden" name="_q" value={q} />
                              <input type="hidden" name="_range" value={String(rangeDays)} />
                              <input type="hidden" name="_pillar" value={pillarFilter} />
                              <input type="hidden" name="_bstatus" value={briefStatusFilter} />
                              <input type="hidden" name="keyword" value={item.keyword} />
                              <input type="hidden" name="targetSlug" value={item.suggestedSlug} />
                              <input type="hidden" name="suggestedTitle" value={item.keyword} />
                              <input type="hidden" name="pillar" value={pillarFilter !== 'all' ? pillarFilter : 'ai-agent-sme'} />
                              <button type="submit" class="rounded border border-line bg-paper px-2 py-1 text-xs font-semibold hover:border-accent">
                                + Giao Agent viết
                              </button>
                            </form>
                          )}
                          {item.matchedArticle ? (
                            <a href={`/admin/bai-viet/${item.matchedArticle.id}`} class="text-xs font-semibold">
                              Sửa bài
                            </a>
                          ) : (
                            <a href={draftHref} class="text-xs font-semibold">
                              Viết bài nháp →
                            </a>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </section>

  {/* Khối 2: Google Search Console */}
  <section class="mb-8 rounded-lg border border-line bg-panel p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold">2. Hiệu quả tìm kiếm Google ({dash.fromDay} → {dash.toDay})</h2>
        <p class="text-xs text-muted">
          {dash.gscSnapshot?.data?.syncedAt
            ? `Cập nhật gần nhất: ${dash.gscSnapshot.data.syncedAt}`
            : 'Chưa đồng bộ dữ liệu trực tiếp từ Google Search Console.'}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {[7, 28, 90].map((r) => (
          <a
            href={buildRedirectUrl(ctxParams, { range: String(r) })}
            class={`rounded-md px-3 py-1.5 text-xs font-semibold no-underline ${
              rangeDays === r ? 'bg-ink text-paper' : 'border border-line text-ink'
            }`}
          >
            {r} ngày
          </a>
        ))}
        <form method="post" action="/admin/seo">
          <input type="hidden" name="_action" value="sync_gsc" />
          <input type="hidden" name="_q" value={q} />
          <input type="hidden" name="_range" value={String(rangeDays)} />
          <button type="submit" class="admin-btn text-xs">Đồng bộ Search Console</button>
        </form>
        <form method="post" action="/admin/seo">
          <input type="hidden" name="_action" value="submit_sitemap" />
          <input type="hidden" name="_q" value={q} />
          <input type="hidden" name="_range" value={String(rangeDays)} />
          <button type="submit" class="admin-btn-ghost text-xs">Gửi Sitemap lên Google</button>
        </form>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-4">
      <div class="rounded-lg border border-line bg-paper p-3.5">
        <span class="block text-xs text-muted">Lượt nhấp (Clicks)</span>
        <span class="text-2xl font-bold">{fmtNum(dash.gscTotals.clicks)}</span>
      </div>
      <div class="rounded-lg border border-line bg-paper p-3.5">
        <span class="block text-xs text-muted">Lượt hiển thị (Impressions)</span>
        <span class="text-2xl font-bold">{fmtNum(dash.gscTotals.impressions)}</span>
      </div>
      <div class="rounded-lg border border-line bg-paper p-3.5">
        <span class="block text-xs text-muted">Tỷ lệ bấm (CTR)</span>
        <span class="text-2xl font-bold">{fmtPct(dash.gscTotals.ctr)}</span>
      </div>
      <div class="rounded-lg border border-line bg-paper p-3.5">
        <span class="block text-xs text-muted">Vị trí trung bình</span>
        <span class="text-2xl font-bold">{dash.gscTotals.avgPosition > 0 ? dash.gscTotals.avgPosition : '—'}</span>
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <div>
        <h3 class="mb-2 text-sm font-bold">Cơ hội tăng tỷ lệ bấm (Hiển thị nhiều, ít người bấm)</h3>
        <table class="admin-table">
          <thead>
            <tr><th>Từ khóa</th><th>Hiển thị</th><th>Vị trí</th><th>CTR</th><th></th></tr>
          </thead>
          <tbody>
            {dash.lowCtrOpportunities.length === 0 ? (
              <tr>
                <td colspan="5" class="text-xs text-muted">
                  Chưa có dữ liệu từ khóa từ Google Search Console (tên miền mới thêm cần vài ngày đầu để Google thu thập).
                </td>
              </tr>
            ) : (
              dash.lowCtrOpportunities.map((row) => (
                <tr>
                  <td>
                    <div class="font-semibold">{row.query}</div>
                    <div class="text-xs text-muted">{row.actionHint}</div>
                  </td>
                  <td>{fmtNum(row.impressions)}</td>
                  <td>{row.position}</td>
                  <td>{fmtPct(row.ctr)}</td>
                  <td>
                    <a
                      href={buildRedirectUrl(ctxParams, { q: row.query })}
                      class="text-xs font-semibold"
                    >
                      Nghiên cứu
                    </a>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <div>
        <h3 class="mb-2 text-sm font-bold">Top từ khóa khách tìm tới tqd.me</h3>
        <table class="admin-table">
          <thead>
            <tr><th>Từ khóa</th><th>Nhấp</th><th>Hiển thị</th><th>Vị trí</th></tr>
          </thead>
          <tbody>
            {dash.topQueries.length === 0 ? (
              <tr>
                <td colspan="4" class="text-xs text-muted">
                  Chưa có truy vấn tìm kiếm nào được ghi nhận. Bạn có thể nghiên cứu từ khóa ở mục 1 để viết bài trước.
                </td>
              </tr>
            ) : (
              dash.topQueries.slice(0, 15).map((row) => (
                <tr>
                  <td>
                    <div>{row.query}</div>
                    {row.topPage && <div class="text-xs text-muted">{row.topPage}</div>}
                  </td>
                  <td>{fmtNum(row.clicks)}</td>
                  <td>{fmtNum(row.impressions)}</td>
                  <td>{row.position}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* Khối 3: Giỏ từ khóa & Lộ trình bài viết */}
  <section class="rounded-lg border border-line bg-panel p-5">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold">3. Kho từ khóa tổng hợp ({dash.totalKeywords} từ khóa)</h2>
        <p class="text-xs text-muted">
          Ý tưởng: {dash.countsByStatus.idea} · Đã lên lịch: {dash.countsByStatus.planned} · Đang viết nháp: {dash.countsByStatus.drafting} · Đã đăng: {dash.countsByStatus.published}
        </p>
      </div>
      <form method="post" action="/admin/seo">
        <input type="hidden" name="_action" value="seed_queue" />
        <input type="hidden" name="_q" value={q} />
        <input type="hidden" name="_range" value={String(rangeDays)} />
        <button type="submit" class="admin-btn-ghost text-xs">
          Nạp & Đồng bộ kho từ khóa 5 Trụ cột
        </button>
      </form>
    </div>

    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-1.5 text-xs">
        <a
          href={buildRedirectUrl(ctxParams, { status: 'all' })}
          class={`rounded-md px-2.5 py-1.5 font-semibold no-underline ${
            statusFilter === 'all' ? 'bg-ink text-paper' : 'border border-line text-ink'
          }`}
        >
          Tất cả ({dash.totalKeywords})
        </a>
        {SEO_STATUSES.map((st) => (
          <a
            href={buildRedirectUrl(ctxParams, { status: st })}
            class={`rounded-md px-2.5 py-1.5 font-semibold no-underline ${
              statusFilter === st ? 'bg-ink text-paper' : 'border border-line text-ink'
            }`}
          >
            {STATUS_LABELS[st]} ({dash.countsByStatus[st]})
          </a>
        ))}
      </div>

      <form method="get" action="/admin/seo" class="flex flex-wrap items-center gap-2">
        {q && <input type="hidden" name="q" value={q} />}
        <input type="hidden" name="range" value={String(rangeDays)} />
        <input type="hidden" name="status" value={statusFilter} />
        <input type="hidden" name="pillar" value={pillarFilter} />
        <input type="hidden" name="bstatus" value={briefStatusFilter} />
        <select name="priority" class="min-h-9 rounded-md border border-line bg-paper px-2 text-xs">
          <option value="all" selected={priorityFilter === 'all'}>Mọi độ ưu tiên</option>
          {SEO_PRIORITIES.map((p) => (
            <option value={p} selected={priorityFilter === p}>Ưu tiên: {PRIORITY_LABELS[p]}</option>
          ))}
        </select>
        <input
          type="search"
          name="filter"
          value={textFilter}
          placeholder="Lọc nhanh từ khóa, nhóm..."
          class="min-h-9 rounded-md border border-line bg-paper px-2.5 text-xs"
        />
        <button type="submit" class="admin-btn-ghost text-xs">Lọc</button>
      </form>
    </div>

    <details class="mb-5 rounded-lg border border-line bg-tint p-3.5 text-sm">
      <summary class="cursor-pointer text-xs font-semibold">+ Thêm thủ công một từ khóa mới vào giỏ</summary>
      <form method="post" action="/admin/seo" class="admin-form mt-3">
        <input type="hidden" name="_action" value="save_keyword" />
        <input type="hidden" name="_q" value={q} />
        <input type="hidden" name="_range" value={String(rangeDays)} />
        <input type="hidden" name="_status" value={statusFilter} />
        <input type="hidden" name="_priority" value={priorityFilter} />
        <input type="hidden" name="_filter" value={textFilter} />
        <div class="grid gap-3 sm:grid-cols-2">
          <label>
            Từ khóa mục tiêu
            <input name="keyword" required maxlength="160" placeholder="vd: cách tạo trợ lý ai bán hàng" />
          </label>
          <label>
            Nhóm chủ đề
            <input name="cluster" maxlength="120" placeholder="vd: AI Agent & Nhân sự số SME" />
          </label>
          <label>
            Ưu tiên
            <select name="priority">
              {SEO_PRIORITIES.map((p) => <option value={p} selected={p === 'high'}>{PRIORITY_LABELS[p]}</option>)}
            </select>
          </label>
          <label>
            Trạng thái
            <select name="status">
              {SEO_STATUSES.map((s) => <option value={s} selected={s === 'planned'}>{STATUS_LABELS[s]}</option>)}
            </select>
          </label>
        </div>
        <label>
          Tiêu đề bài viết dự kiến
          <input name="suggestedTitle" maxlength="220" placeholder="Có thể bỏ trống" />
        </label>
        <button type="submit" class="admin-btn text-xs">Lưu từ khóa</button>
      </form>
    </details>

    <div class="overflow-x-auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Từ khóa & Nhóm</th>
            <th>Mục đích</th>
            <th>Số liệu</th>
            <th>Trạng thái / Ưu tiên / Slug</th>
            <th>Bài viết</th>
          </tr>
        </thead>
        <tbody>
          {dash.keywords.length === 0 ? (
            <tr>
              <td colspan="5" class="text-xs text-muted">
                Chưa có từ khóa phù hợp bộ lọc. Bấm “Nạp & Đồng bộ kho từ khóa 5 Trụ cột” hoặc tìm kiếm từ khóa mới ở mục 1.
              </td>
            </tr>
          ) : (
            dash.keywords.slice(0, 80).map((kw) => {
              const formId = `kw-form-${kw.id}`;
              const draftUrl = `/admin/bai-viet/moi?title=${encodeURIComponent(kw.suggestedTitle || kw.keyword)}&slug=${encodeURIComponent(kw.targetSlug || '')}&kw=${encodeURIComponent(kw.keyword)}&summary=${encodeURIComponent(kw.notes || '')}`;
              return (
                <tr>
                  <td class="align-top">
                    <div class="font-semibold">{kw.keyword}</div>
                    {kw.cluster && <div class="text-xs text-muted">{kw.cluster}</div>}
                    {kw.suggestedTitle && kw.suggestedTitle !== kw.keyword && (
                      <div class="mt-0.5 text-xs text-muted">Đề xuất: {kw.suggestedTitle}</div>
                    )}
                  </td>
                  <td class="align-top text-xs">
                    <span class="rounded bg-tint px-2 py-0.5">{INTENT_LABELS[kw.intent]}</span>
                  </td>
                  <td class="align-top text-xs">
                    {kw.volume !== null || kw.difficulty !== null ? (
                      <div>
                        <div>Vol: <strong>{kw.volume !== null ? fmtNum(kw.volume) : '—'}</strong></div>
                        <div>KD: <strong>{kw.difficulty !== null ? kw.difficulty : '—'}</strong></div>
                      </div>
                    ) : (
                      <span class="text-muted">—</span>
                    )}
                  </td>
                  <td class="align-top">
                    <form id={formId} method="post" action="/admin/seo" class="flex flex-wrap items-center gap-1.5 text-xs">
                      <input type="hidden" name="_action" value="update_keyword" />
                      <input type="hidden" name="id" value={String(kw.id)} />
                      <input type="hidden" name="_q" value={q} />
                      <input type="hidden" name="_range" value={String(rangeDays)} />
                      <input type="hidden" name="_status" value={statusFilter} />
                      <input type="hidden" name="_priority" value={priorityFilter} />
                      <input type="hidden" name="_filter" value={textFilter} />
                      <input type="hidden" name="intent" value={kw.intent} />
                      <input type="hidden" name="cluster" value={kw.cluster} />
                      <select name="status" class="rounded border border-line bg-paper px-1.5 py-1 text-xs" aria-label={`Trạng thái ${kw.keyword}`}>
                        {SEO_STATUSES.map((s) => (
                          <option value={s} selected={kw.status === s}>{STATUS_LABELS[s]}</option>
                        ))}
                      </select>
                      <select name="priority" class="rounded border border-line bg-paper px-1.5 py-1 text-xs" aria-label={`Ưu tiên ${kw.keyword}`}>
                        {SEO_PRIORITIES.map((p) => (
                          <option value={p} selected={kw.priority === p}>{PRIORITY_LABELS[p]}</option>
                        ))}
                      </select>
                      <input
                        name="targetSlug"
                        value={kw.targetSlug ?? ''}
                        placeholder="slug-bai-viet"
                        class="w-36 rounded border border-line bg-paper px-1.5 py-1 font-mono text-xs"
                        aria-label={`Slug bài viết cho ${kw.keyword}`}
                      />
                      <button type="submit" class="rounded border border-line bg-panel px-2 py-1 text-xs font-semibold hover:border-accent">
                        Lưu
                      </button>
                    </form>
                  </td>
                  <td class="align-top text-xs">
                    <div class="flex flex-col gap-1.5">
                      {kw.articleId ? (
                        <>
                          <a href={`/admin/bai-viet/${kw.articleId}`} class="font-semibold">
                            {kw.articleStatus === 'published' ? 'Sửa bài đã đăng' : 'Sửa bản nháp'}
                          </a>
                          {kw.articleStatus === 'published' && kw.targetSlug && (
                            <a href={`/bai-viet/${kw.targetSlug}`} target="_blank" rel="noopener">
                              Xem trên web ↗
                            </a>
                          )}
                        </>
                      ) : (
                        <a href={draftUrl} class="font-semibold">
                          Viết bài nháp →
                        </a>
                      )}
                      <form method="post" action="/admin/seo" onsubmit="return confirm('Xoá từ khóa này khỏi giỏ?')">
                        <input type="hidden" name="_action" value="delete_keyword" />
                        <input type="hidden" name="id" value={String(kw.id)} />
                        <input type="hidden" name="_q" value={q} />
                        <input type="hidden" name="_range" value={String(rangeDays)} />
                        <input type="hidden" name="_status" value={statusFilter} />
                        <input type="hidden" name="_priority" value={priorityFilter} />
                        <input type="hidden" name="_filter" value={textFilter} />
                        <button type="submit" class="text-xs text-red-700 underline">Xoá</button>
                      </form>
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
    {dash.keywords.length > 80 && (
      <p class="mt-2 text-xs text-muted">
        Đang hiển thị 80 từ khóa đầu tiên trong tổng {dash.keywords.length} từ khóa khớp bộ lọc (dùng ô lọc nhanh ở trên để tìm chính xác).
      </p>
    )}
  </section>
</AdminLayout>
