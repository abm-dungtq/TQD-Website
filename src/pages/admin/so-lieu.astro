---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { InputError, saveSetting } from '../../lib/admin-writes';
import { getSite } from '../../lib/content';

// Second line of defence; the middleware sets this only for a valid session.
if (!Astro.locals.admin) return new Response('Unauthorized', { status: 401 });

const site = await getSite(env.DB);
let statsText = JSON.stringify(site.stats, null, 2);
let topicsText = JSON.stringify(site.topics, null, 2);
let error = '';

const parse = (label: string, text: string): Record<string, unknown> => {
  try {
    const value = JSON.parse(text);
    if (value && typeof value === 'object' && !Array.isArray(value)) return value;
  } catch {
    // fall through to the shared message
  }
  throw new InputError(`${label}: JSON không hợp lệ.`);
};
const isStringList = (v: unknown) => Array.isArray(v) && v.every((s) => typeof s === 'string');
// Every public page renders the stats, so a malformed entry would break the whole site.
const isRecord = (v: unknown): v is Record<string, unknown> => Boolean(v) && typeof v === 'object' && !Array.isArray(v);
const isHeadline = (v: unknown) =>
  isRecord(v) && typeof v.label === 'string' && typeof v.value === 'string' && (v.note === undefined || typeof v.note === 'string');
const isGroup = (v: unknown) => isRecord(v) && typeof v.label === 'string' && typeof v.count === 'number' && Number.isFinite(v.count) && v.count >= 0;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const target = String(form.get('target'));
  const text = String(form.get('json') ?? '');
  try {
    if (target === 'stats') {
      statsText = text;
      const stats = parse('Số liệu', text);
      if (!Array.isArray(stats.headline) || !Array.isArray(stats.byGroup)) {
        throw new InputError('Số liệu cần mảng "headline" và "byGroup".');
      }
      if (!stats.headline.every(isHeadline)) {
        throw new InputError('Mỗi mục "headline" cần "label" và "value" là chuỗi ("note" tuỳ chọn).');
      }
      if (!stats.byGroup.every(isGroup)) {
        throw new InputError('Mỗi mục "byGroup" cần "label" là chuỗi và "count" là số không âm.');
      }
      await saveSetting(env.DB, 'stats', stats);
    } else if (target === 'topics') {
      topicsText = text;
      const topics = parse('Chủ đề', text);
      if (!isStringList(topics.howTo) || !isStringList(topics.marketWatch)) {
        throw new InputError('Chủ đề cần "howTo" và "marketWatch" là mảng chuỗi.');
      }
      await saveSetting(env.DB, 'topics', topics);
    } else {
      throw new InputError('Không rõ mục cần lưu.');
    }
    return Astro.redirect('/admin/so-lieu?ok=1', 303);
  } catch (e) {
    if (!(e instanceof InputError)) throw e;
    Astro.response.status = 400;
    error = e.message;
  }
}
const saved = Astro.url.searchParams.has('ok');
---

<AdminLayout title="Số liệu và chủ đề">
  {saved && <p class="admin-ok">Đã lưu.</p>}
  {error && <p class="admin-error" role="alert">{error}</p>}
  <form method="post" class="admin-form mb-10">
    <input type="hidden" name="target" value="stats" />
    <label>Số liệu (JSON) <textarea name="json" class="mono" rows="18">{statsText}</textarea></label>
    <button type="submit" class="admin-btn">Lưu số liệu</button>
  </form>
  <form method="post" class="admin-form">
    <input type="hidden" name="target" value="topics" />
    <label>Chủ đề (JSON) <textarea name="json" class="mono" rows="12">{topicsText}</textarea></label>
    <button type="submit" class="admin-btn">Lưu chủ đề</button>
  </form>
</AdminLayout>
