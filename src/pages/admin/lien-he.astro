---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatLinks, InputError, parseLinks, saveSetting } from '../../lib/admin-writes';
import { getSite } from '../../lib/content';

// Second line of defence; the middleware sets this only for a valid session.
if (!Astro.locals.admin) return new Response('Unauthorized', { status: 401 });

const site = await getSite(env.DB);
let linksText = formatLinks(site.links);
let error = '';

if (Astro.request.method === 'POST') {
  linksText = String((await Astro.request.formData()).get('links') ?? '');
  try {
    await saveSetting(env.DB, 'links', parseLinks(linksText));
    return Astro.redirect('/admin/lien-he?ok=1', 303);
  } catch (e) {
    if (!(e instanceof InputError)) throw e;
    Astro.response.status = 400;
    error = e.message;
  }
}
const saved = Astro.url.searchParams.has('ok');
---

<AdminLayout title="Liên hệ">
  {saved && <p class="admin-ok">Đã lưu.</p>}
  {error && <p class="admin-error" role="alert">{error}</p>}
  <form method="post" class="admin-form">
    <label>Liên kết (mỗi dòng: Nhãn | https://... hoặc mailto:...)
      <textarea name="links" class="mono" rows="10">{linksText}</textarea>
    </label>
    <button type="submit" class="admin-btn">Lưu</button>
  </form>
</AdminLayout>
