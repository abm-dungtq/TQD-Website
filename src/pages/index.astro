---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesktopShell from '../components/DesktopShell.astro';
import SectionBody from '../components/SectionBody.astro';
import { person, sections } from '../data/profile';
---

<BaseLayout description={`${person.role}. ${person.intro}`} path="/">
  <DesktopShell slot="before" />
  <h1 class="sr-only">{person.name} ({person.handle})</h1>
  <SectionBody id="ho-so" eager />
  <h2 class="mb-4 mt-12 text-lg font-semibold">Các mục</h2>
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      sections
        .filter((s) => s.id !== 'ho-so')
        .map((s) => (
          <li>
            <a
              href={`/${s.id}`}
              class="block h-full rounded-xl border border-line bg-panel p-4 text-ink no-underline hover:border-accent"
            >
              <span class="font-semibold">{s.title}</span>
              <span class="mt-1 block text-sm text-muted">{s.short}</span>
            </a>
          </li>
        ))
    }
  </ul>
</BaseLayout>
