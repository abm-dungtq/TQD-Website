---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import DesktopShell from '../components/DesktopShell.astro';
import MobileShell from '../components/MobileShell.astro';
import SectionBody from '../components/SectionBody.astro';
import { introParagraphs, loadSiteData } from '../lib/content';
import { personNode } from '../lib/structured-data';

const data = await loadSiteData(env.DB);
const { person, sections } = data.site;
---

<BaseLayout
  site={data.site}
  description={`${person.role}. ${introParagraphs(person.intro)[0] ?? ''}`}
  path="/"
  markdownPath="/index.md"
  ogImagePath="/og.png"
  jsonLd={[personNode(data.site, Astro.url.origin)]}
>
  <DesktopShell slot="before" data={data} />
  {/* Phones get the OS home screen with above-the-fold B2B value prop; wide screens without JS get the profile and section list. */}
  <div class="lg:hidden">
    <MobileShell site={data.site} />
  </div>
  <div class="hidden lg:block">
    <SectionBody id="ho-so" data={data} eager />
    <h2 class="display mb-6 mt-16 text-3xl">Các mục</h2>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        sections
          .filter((s) => s.id !== 'ho-so')
          .map((s) => (
            <li>
              <a
                href={`/${s.id}`}
                class="lux-card block h-full p-6 text-ink no-underline"
              >
                <span class="display block text-2xl">{s.title}</span>
                <span class="mt-2 block text-sm text-muted">{s.short}</span>
              </a>
            </li>
          ))
      }
      <li>
        <a href="/tai-video" class="lux-card block h-full p-6 text-ink no-underline">
          <span class="display block text-2xl">Tải Video</span>
          <span class="mt-2 block text-sm text-muted">
            Tải video MP4 chuẩn H.264, tách nhạc MP3 320kbps, bóc băng lời thoại AI và nhân bản kịch bản chuẩn Viết Pro.
          </span>
        </a>
      </li>
    </ul>
  </div>
</BaseLayout>
