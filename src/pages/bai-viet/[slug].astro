---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageActions from '../../components/PageActions.astro';
import { getArticle, getSite, listArticles, mediaUrl } from '../../lib/content';
import { articleNode, breadcrumbNode, personNode, toIsoUtc } from '../../lib/structured-data';
import { estimateReadingMinutes, injectHeadingIdsAndToc } from '../../lib/toc';

const slug = Astro.params.slug ?? '';
const article = await getArticle(env.DB, slug);
if (!article) return Astro.rewrite('/404');

const [site, allArticles, hasCoverInBucket] = await Promise.all([
  getSite(env.DB),
  listArticles(env.DB),
  article.coverKey
    ? env.MEDIA?.head?.(article.coverKey).then(Boolean).catch(() => false)
    : Promise.resolve(false),
]);

const published = article.publishedAt
  ? new Intl.DateTimeFormat('vi-VN', {
      timeZone: 'Asia/Ho_Chi_Minh',
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    }).format(new Date(toIsoUtc(article.publishedAt)))
  : '';

const origin = new URL('/', Astro.url.origin).href;
const canonicalUrl = new URL(`/bai-viet/${article.slug}`, Astro.url.origin).href;
const { html: bodyHtmlWithIds, headings } = injectHeadingIdsAndToc(article.bodyHtml);
const h2Count = headings.filter((h) => h.level === 2).length;
const showToc = h2Count >= 3;
const readingMinutes = estimateReadingMinutes(article.bodyMd || article.bodyHtml);

const ogImagePath = hasCoverInBucket && article.coverKey ? mediaUrl(article.coverKey) : '/og/bai-viet.png';
const ogImageWidth = 1200;
const ogImageHeight = hasCoverInBucket && article.coverKey ? 675 : 630;
const primaryZalo = site.person.zalo || 'https://zalo.me/trinhquangdung';
const relatedArticles = allArticles.filter((a) => a.slug !== article.slug).slice(0, 3);
const formatDateShort = (iso?: string) => (iso ? iso.slice(0, 10).split('-').reverse().join('/') : '');
---

<BaseLayout
  site={site}
  title={article.title}
  description={article.summary || article.title}
  path={`/bai-viet/${article.slug}`}
  ogType="article"
  markdownPath={`/bai-viet/${article.slug}.md`}
  ogImagePath={ogImagePath}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogImageAlt={article.title}
  articleMeta={{
    publishedTime: article.publishedAt ? toIsoUtc(article.publishedAt) : undefined,
    modifiedTime: toIsoUtc(article.updatedAt),
    author: site.person.name,
    tags: article.tags,
  }}
  jsonLd={[
    personNode(site, Astro.url.origin),
    articleNode(article, canonicalUrl),
    breadcrumbNode(
      [
        { name: 'Trang chủ', url: origin },
        { name: 'Bài viết', url: `${origin}bai-viet` },
        { name: article.title, url: canonicalUrl },
      ],
      canonicalUrl,
    ),
  ]}
>
  <article class="mx-auto max-w-3xl">
    <p class="eyebrow mb-5 flex-wrap">
      <a href="/bai-viet" class="inline-flex min-h-11 -my-3 items-center no-underline">← Bài viết</a>
      <span class="eyebrow-rule" aria-hidden="true" />
      {published && <time class="tabular-nums" datetime={toIsoUtc(article.publishedAt!)}>{published}</time>}
      <span class="tabular-nums text-muted">· ~{readingMinutes} phút đọc</span>
    </p>

    <h1 class="display mb-5 text-[2.35rem] sm:text-6xl">{article.title}</h1>
    {article.summary && <p class="mb-6 text-lg leading-relaxed text-muted">{article.summary}</p>}

    <div class="mb-6 flex flex-wrap items-center gap-3 text-xs text-muted">
      <a href="/ho-so" class="inline-flex min-h-11 items-center gap-2.5 font-medium text-ink no-underline">
        <img src={site.person.portraitSmall} alt={site.person.name} width="32" height="32" class="size-8 rounded-full border border-champagne object-cover" />
        <span>{site.person.name} ({site.person.handle})</span>
      </a>
      {
        article.tags.length > 0 && (
          <ul class="flex flex-wrap gap-1.5" aria-label="Chủ đề bài viết">
            {article.tags.map((t) => (
              <li class="lux-chip px-2.5 py-0.5">{t}</li>
            ))}
          </ul>
        )
      }
    </div>

    <PageActions
      markdownPath={`/bai-viet/${article.slug}.md`}
      canonicalUrl={canonicalUrl}
      title={article.title}
      class="mb-8 border-y border-line py-3.5"
    />

    {
      article.coverKey && hasCoverInBucket && (
        <img
          src={mediaUrl(article.coverKey)}
          alt={article.title}
          class="article-cover"
          width="1200"
          height="675"
          fetchpriority="high"
        />
      )
    }

    {
      showToc && (
        <details open class="lux-card mb-8 p-5">
          <summary class="flex min-h-11 -my-2 cursor-pointer items-center justify-between gap-2 font-semibold text-ink select-none">
            <span class="inline-flex items-center gap-2 text-sm uppercase tracking-wider text-accent">
              <Icon name="list" size={16} />
              <span>Mục lục bài viết ({headings.length} phần)</span>
            </span>
            <span class="text-xs font-medium text-muted">Thu gọn / Mở</span>
          </summary>
          <nav aria-label="Mục lục bài viết" class="mt-3 border-t border-line pt-3">
            <ol class="flex flex-col gap-1 text-sm">
              {headings.map((h) => (
                <li class={h.level === 3 ? 'pl-4' : ''}>
                  <a
                    href={`#${h.id}`}
                    class="inline-flex min-h-11 sm:min-h-9 items-center py-1 text-ink/90 no-underline hover:text-accent hover:underline"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )
    }

    {/* bodyHtmlWithIds comes from sanitized renderMarkdown + deterministic Vietnamese heading anchors. */}
    <div class="prose-article" set:html={bodyHtmlWithIds} />

    {/* Author B2B Consulting CTA Card */}
    <aside class="lux-card mt-14 flex flex-col gap-5 border-champagne/55 bg-gradient-to-br from-panel via-panel to-tint/75 p-6 sm:flex-row sm:items-center sm:p-7" aria-label="Thông tin tác giả & Tư vấn doanh nghiệp">
      <img
        src={site.person.portraitSmall}
        alt={site.person.name}
        width="80"
        height="80"
        loading="lazy"
        decoding="async"
        class="size-16 shrink-0 rounded-full border border-champagne object-cover sm:size-20"
      />
      <div class="flex flex-1 flex-col gap-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent">Tác giả · Đào tạo &amp; Triển khai AI Thực chiến</p>
        <h2 class="display text-2xl sm:text-3xl">{site.person.name} ({site.person.handle})</h2>
        <p class="text-sm leading-relaxed text-muted">
          Cần đào tạo đội ngũ sử dụng AI đúng chuẩn, xây dựng hệ thống Skill chống văn mẫu hoặc thiết kế AI Agent theo quy trình riêng của doanh nghiệp (kinh nghiệm thực địa tại BSR, Agribank, ABIC, Hanoitourist)?
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-2.5">
          <a
            href={primaryZalo}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-gold text-xs sm:text-sm"
          >
            <Icon name="chat" size={16} />
            <span>Nhắn Zalo đặt lịch tư vấn</span>
          </a>
          <a href="/san-pham" class="btn-outline-gold text-xs sm:text-sm">
            <Icon name="box" size={16} />
            <span>Xem sản phẩm &amp; Skill</span>
          </a>
        </div>
      </div>
    </aside>

    {
      relatedArticles.length > 0 && (
        <section class="mt-12 border-t border-line pt-10" aria-label="Bài viết liên quan">
          <h2 class="display mb-5 text-3xl">Bài viết &amp; Ghi chép khác</h2>
          <ul class="grid gap-4 sm:grid-cols-2">
            {relatedArticles.map((rel) => (
              <li class="lux-card relative flex flex-col gap-2 p-5">
                <p class="font-mono text-xs text-muted">{formatDateShort(rel.publishedAt)}</p>
                <h3 class="display text-xl">
                  <a
                    href={`/bai-viet/${rel.slug}`}
                    class="text-ink no-underline after:absolute after:inset-0 hover:text-accent-ink"
                  >
                    {rel.title}
                  </a>
                </h3>
                {rel.summary && <p class="line-clamp-2 text-xs leading-relaxed text-muted">{rel.summary}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<script>
  import '../../scripts/tiktok.ts';
</script>
