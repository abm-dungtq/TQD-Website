---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageActions from '../../components/PageActions.astro';
import { getSite } from '../../lib/content';
import { renderMarkdown } from '../../lib/markdown';
import { breadcrumbNode, personNode } from '../../lib/structured-data';
import { getViralShare, VIRAL_FORMATS } from '../../lib/viral';

const id = Astro.params.id ?? '';
// Check share existence BEFORE querying site settings to avoid wasted D1 reads on 404 (CB-11)
const share = await getViralShare(env.DB, id);
if (!share) return Astro.rewrite('/404');

const site = await getSite(env.DB);
const isCurated = share.shareId.startsWith('c-');

// Policy #3: Admin-created curated showcase shares (c-*) are indexable; unverified public shares stay noindex, nofollow
Astro.response.headers.set('X-Robots-Tag', isCurated ? 'index, follow' : 'noindex, nofollow');

const formatSpec = VIRAL_FORMATS.find((f) => f.key === share.formatKey);
const formatLabel = formatSpec ? formatSpec.label : 'Báo cáo X-Quang Video Viral';

// Unverified public shares strip external links via { allowExternalLinks: false } for anti-phishing safety
const [xrayHtml, scriptHtml] = await Promise.all([
  share.xrayMarkdown
    ? renderMarkdown(share.xrayMarkdown, { allowExternalLinks: isCurated })
    : Promise.resolve(''),
  share.scriptMarkdown
    ? renderMarkdown(share.scriptMarkdown, { allowExternalLinks: isCurated })
    : Promise.resolve(''),
]);

const createdLabel = share.createdAt
  ? new Intl.DateTimeFormat('vi-VN', {
      timeZone: 'Asia/Ho_Chi_Minh',
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    }).format(new Date(share.createdAt * 1000))
  : '';

const durationLabel =
  share.duration > 0
    ? `${Math.floor(share.duration / 60)}:${String(Math.round(share.duration % 60)).padStart(2, '0')}`
    : '';

const pageTitle = `Mổ xẻ Viral: ${share.title}`;
const pageDesc = share.industry
  ? `Bóc tách công thức video "${share.title}" (${share.platformLabel}) & chuyển thể kịch bản sang ngành ${share.industry} chuẩn Viết Pro (${share.vietProScore}/100) tại tqd.me.`
  : `Bóc tách X-Quang công thức viral & kịch bản nhân bản từ video "${share.title}" (${share.platformLabel}) chuẩn Viết Pro (${share.vietProScore}/100) tại tqd.me.`;

const origin = new URL('/', Astro.url.origin).href;
const canonicalUrl = new URL(`/xray/${share.shareId}`, Astro.url.origin).href;
const primaryZalo = site.person.zalo || 'https://zalo.me/trinhquangdung';
---

<BaseLayout
  site={site}
  title={pageTitle}
  description={pageDesc}
  path={`/xray/${share.shareId}`}
  ogType="article"
  markdownPath={`/xray/${share.shareId}.md`}
  ogImagePath="/og/xray.png"
  jsonLd={[
    personNode(site, Astro.url.origin),
    breadcrumbNode(
      [
        { name: 'Trang chủ', url: origin },
        { name: 'Xưởng Mổ Xẻ Video', url: `${origin}tai-video` },
        { name: share.title, url: canonicalUrl },
      ],
      canonicalUrl,
    ),
  ]}
>
  <article class="mx-auto flex max-w-4xl flex-col gap-6">
    <p class="eyebrow flex-wrap">
      <a href="/tai-video" class="inline-flex min-h-11 -my-3 items-center no-underline">← Mở Xưởng Tải &amp; Mổ Xẻ Video</a>
      <span class="eyebrow-rule" aria-hidden="true"></span>
      {createdLabel && <span class="eyebrow-index">{createdLabel}</span>}
      {isCurated && <span class="lux-chip px-2.5 py-0.5 text-[0.6875rem] font-semibold">Case Study Tuyển Chọn</span>}
    </p>

    <header class="lux-card p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="lux-chip inline-flex items-center gap-1.5 px-3 py-1 font-semibold">
          <Icon name="dna" size={14} />
          <span>Báo cáo X-Quang Viral</span>
        </span>
        {share.platformLabel && <span class="lux-chip px-3 py-1">{share.platformLabel}</span>}
        {
          durationLabel && (
            <span class="lux-chip inline-flex items-center gap-1 px-3 py-1 font-mono">
              <Icon name="clock" size={13} />
              <span>{durationLabel}</span>
            </span>
          )
        }
        <span class="lux-chip inline-flex items-center gap-1.5 px-3 py-1 font-semibold text-accent-ink">
          <Icon name="sparkles" size={14} />
          <span>Chuẩn Viết Pro: {share.vietProScore}/100</span>
        </span>
      </div>

      <h1 class="display mt-4 text-3xl sm:text-5xl">{share.title}</h1>
      <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-muted">
        {share.uploader && <span>Kênh gốc: <strong>{share.uploader}</strong> ·</span>}
        <a
          href={share.canonicalUrl}
          target="_blank"
          rel="noopener noreferrer nofollow ugc"
          class="inline-flex min-h-11 -my-2 items-center gap-1 underline"
        >
          <span>Xem video gốc</span>
          <Icon name="external" size={14} />
        </a>
      </p>

      {
        share.industry && (
          <div class="mt-4 flex items-start gap-2.5 rounded-xl border border-line bg-tint/70 px-4 py-3 text-sm">
            <Icon name="wand" size={18} class="mt-0.5 shrink-0 text-accent" />
            <p>
              <strong>Đổi Ngành Giữ Khung:</strong> Đã chuyển thể cấu trúc sang ngành{' '}
              <span class="font-semibold text-accent-ink">{share.industry}</span> ({formatLabel})
            </p>
          </div>
        )
      }

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <a
          href={`/tai-video?url=${encodeURIComponent(share.canonicalUrl)}&tab=viral`}
          class="btn-gold text-xs sm:text-sm"
        >
          <Icon name="bolt" size={16} />
          <span>Mổ xẻ lại / Đổi sang ngành của bạn</span>
        </a>
        <a
          href="/tai-video"
          class="btn-outline-gold text-xs sm:text-sm"
        >
          <Icon name="film" size={16} />
          <span>Dán link video khác (Miễn phí)</span>
        </a>
      </div>

      <PageActions
        markdownPath={`/xray/${share.shareId}.md`}
        canonicalUrl={canonicalUrl}
        title={pageTitle}
        class="mt-6 border-t border-line pt-4"
      />
    </header>

    {
      scriptHtml && (
        <section class="lux-card p-6 sm:p-8" aria-label="Kịch bản nhân bản chuẩn Viết Pro">
          <div class="mb-5 flex flex-wrap items-center justify-between gap-2 border-b border-line pb-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-muted">Kịch bản chuyển thể</p>
              <h2 class="display text-2xl sm:text-3xl">{formatLabel}</h2>
            </div>
            <span class="lux-chip px-3 py-1 text-xs font-semibold text-accent-ink">
              Viết Pro {share.vietProScore}/100 · Chống văn mẫu AI
            </span>
          </div>
          {/* scriptHtml is sanitized by renderMarkdown (rehype-sanitize + rehypeSitePolicy). */}
          <div class="prose-article overflow-x-auto" set:html={scriptHtml} />
        </section>
      )
    }

    {
      xrayHtml && (
        <section class="lux-card p-6 sm:p-8" aria-label="Phân tích X-Quang yếu tố Viral">
          <div class="mb-5 border-b border-line pb-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">Giải phẫu công thức triệu view</p>
            <h2 class="display text-2xl sm:text-3xl">X-Quang Hook &amp; Nhịp Giữ Chân</h2>
          </div>
          {/* xrayHtml is sanitized by renderMarkdown (rehype-sanitize + rehypeSitePolicy). */}
          <div class="prose-article overflow-x-auto" set:html={xrayHtml} />
        </section>
      )
    }

    <aside class="lux-card flex flex-col justify-between gap-4 border-champagne/50 bg-tint/70 p-6 sm:flex-row sm:items-center sm:p-7">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-accent-ink">Hệ sinh thái AI thực chiến · {site.person.handle}</p>
        <h2 class="display mt-1 text-2xl">Muốn tự động hóa quy trình sản xuất nội dung &amp; AI Agent cho doanh nghiệp?</h2>
        <p class="mt-1 text-sm text-muted">
          Khám phá các chương trình đào tạo AI ứng dụng, bộ kỹ năng nguồn mở Viết Pro và giải pháp triển khai thực tế từ {site.person.name}.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-2.5">
        <a
          href={primaryZalo}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold text-xs sm:text-sm"
        >
          <Icon name="chat" size={16} />
          <span>Nhắn Zalo tư vấn</span>
        </a>
        <a
          href="/san-pham"
          class="btn-outline-gold text-xs sm:text-sm"
        >
          <span>Khám phá Sản phẩm AI</span>
        </a>
      </div>
    </aside>
  </article>
</BaseLayout>
