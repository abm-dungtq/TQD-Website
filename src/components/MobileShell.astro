---
// Phone home screen: compact status row, B2B value proposition + primary Zalo CTA above the fold,
// clean video poster card, and the 7-item OS app grid.
import { env } from 'cloudflare:workers';
import Icon from './Icon.astro';
import { featuredVideo, mediaUrl, type Site } from '../lib/content';

interface Props {
  site: Site;
}

const { person, sections, gallery } = Astro.props.site;
const primaryZalo = person.zalo || 'https://zalo.me/trinhquangdung';
const featured = featuredVideo(gallery);
const hasFeaturedMedia = featured
  ? Boolean(await env.MEDIA?.head?.(featured.key).catch(() => null))
  : false;
const hasFeaturedPoster =
  featured?.poster && hasFeaturedMedia
    ? Boolean(await env.MEDIA?.head?.(featured.poster).catch(() => null))
    : false;
---

<div class="m-home" data-m-home>
  <div class="m-status">
    <time class="m-clock" data-m-clock>--:--</time>
    <span class="m-date" data-m-date></span>
  </div>

  {/* Above-the-fold B2B identity, enterprise proof, and direct conversion CTA */}
  <div class="m-profile">
    <div class="flex items-center gap-3.5">
      <img src={person.portraitSmall} alt={person.name} width="56" height="56" class="m-avatar" />
      <div class="min-w-0">
        <h1 class="display text-2xl leading-tight">{person.name}</h1>
        <p class="mt-0.5 text-xs font-medium text-accent-ink">{person.role}</p>
      </div>
    </div>
    <p class="mt-3 text-xs leading-relaxed text-ink/90">
      Đào tạo AI nội bộ &amp; thiết kế hệ thống <strong>Agent · Skill</strong> gắn sát quy trình doanh nghiệp.
      <span class="text-muted"> Thực địa: BSR · Agribank · ABIC · Hanoitourist.</span>
    </p>
    <div class="mt-3.5 flex flex-wrap items-center gap-2">
      <a
        href={primaryZalo}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-gold flex-1 text-xs"
      >
        <Icon name="chat" size={15} />
        <span>Nhắn Zalo tư vấn</span>
      </a>
      <a href="/san-pham" class="btn-outline-gold text-xs" data-m-open="san-pham">
        <span>Sản phẩm AI</span>
      </a>
    </div>
  </div>

  <nav aria-label="Các mục ứng dụng">
    <ul class="m-grid">
      {
        sections.map((s) => (
          <li>
            <a href={`/${s.id}`} class="m-app" data-m-open={s.id}>
              <span class="m-icon">
                <Icon name={s.icon} size={25} />
              </span>
              <span class="m-label">{s.title}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href="/tai-video" class="m-app">
          <span class="m-icon">
            <Icon name="download" size={25} />
          </span>
          <span class="m-label">Tải Video</span>
        </a>
      </li>
    </ul>
  </nav>

  {
    featured && hasFeaturedMedia && (
      <figure class="m-feature mt-5" data-m-video-card>
        <div class="relative">
          <video
            src={mediaUrl(featured.key)}
            poster={hasFeaturedPoster && featured.poster ? mediaUrl(featured.poster) : person.portrait}
            playsinline
            preload="none"
            width="1280"
            height="720"
            aria-label={featured.caption}
            data-m-video
          />
          <button
            type="button"
            class="m-video-play"
            data-m-video-play
            aria-label={`Phát video: ${featured.caption}`}
          >
            <span class="m-video-pill">
              <Icon name="play" size={16} />
              <span>Xem video đào tạo thực tế</span>
            </span>
          </button>
        </div>
        <figcaption class="m-feature-caption">{featured.caption}</figcaption>
      </figure>
    )
  }
</div>

<div class="m-scrim" data-m-scrim hidden></div>
<section class="m-sheet" role="dialog" aria-modal="true" aria-labelledby="m-sheet-title" data-m-sheet tabindex="-1" hidden>
  <header class="m-sheet-head" data-m-drag>
    <span class="m-handle" aria-hidden="true"></span>
    <h2 id="m-sheet-title" class="m-sheet-title" data-m-title></h2>
    <a class="m-sheet-link inline-flex min-h-11 items-center px-2" data-m-link href="/">Trang riêng →</a>
    <button type="button" class="m-sheet-close" data-m-close aria-label="Đóng">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
      </svg>
    </button>
  </header>
  <div class="m-sheet-body" data-m-body></div>
</section>

<script>
  import '../scripts/mobile-shell.ts';
</script>

<style is:global>
  .m-home {
    max-width: 34rem;
    margin-inline: auto;
    margin-top: -0.75rem;
    padding-bottom: 3.5rem;
    transform-origin: 50% 0;
    transition:
      transform 380ms var(--os-spring),
      opacity 380ms var(--os-ease),
      filter 380ms var(--os-ease);
  }
  .m-home.is-behind {
    transform: scale(0.94);
    opacity: 0.45;
    filter: blur(2px);
  }
  .m-status {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0 0.25rem 0.75rem;
  }
  .m-clock {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .m-date {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .m-feature {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background: var(--color-panel);
    box-shadow: var(--shadow-soft);
  }
  .m-feature video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-tint);
  }
  .m-video-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 0;
    background: linear-gradient(180deg, rgb(27 32 48 / 0.08), rgb(27 32 48 / 0.38));
    cursor: pointer;
  }
  .m-video-play[hidden] {
    display: none;
  }
  .m-video-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-champagne) 60%, #fff);
    background: rgb(255 255 255 / 0.94);
    color: var(--color-accent-ink);
    font-size: 0.8125rem;
    font-weight: 600;
    box-shadow: var(--shadow-lift);
    backdrop-filter: blur(8px);
  }
  .m-feature-caption {
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .m-profile {
    margin-bottom: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background: color-mix(in srgb, var(--color-panel) 88%, transparent);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(12px);
  }
  .m-avatar {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    border: 1px solid var(--color-champagne);
    object-fit: cover;
  }
  .m-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.15rem 0.5rem;
  }
  .m-app {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .m-icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    color: var(--color-accent);
    background: linear-gradient(160deg, var(--color-panel), var(--color-tint));
    border: 1px solid var(--color-line);
    box-shadow:
      inset 0 0 0 3px var(--color-panel),
      inset 0 0 0 4px color-mix(in srgb, var(--color-champagne) 35%, transparent),
      var(--shadow-soft);
    transition: transform 150ms var(--os-ease);
  }
  .m-app:active .m-icon {
    transform: scale(0.92);
  }
  .m-label {
    display: -webkit-box;
    max-width: 100%;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .m-scrim {
    position: fixed;
    inset: 0;
    z-index: 1090;
    background: rgb(27 32 48 / 0.18);
  }
  .m-scrim[hidden],
  .m-sheet[hidden] {
    display: none;
  }
  .m-sheet {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 1100;
    display: flex;
    flex-direction: column;
    height: 92dvh;
    border-radius: 18px 18px 0 0;
    background: var(--color-panel);
    box-shadow: 0 -20px 50px -24px rgb(94 68 19 / 0.4);
    outline: none;
  }
  .m-sheet-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 0.75rem 0.65rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
    touch-action: none;
    user-select: none;
  }
  .m-handle {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 40px;
    height: 4px;
    border-radius: 999px;
    background: var(--color-line);
    transform: translateX(-50%);
  }
  .m-sheet-title {
    font-size: 1.125rem;
    font-weight: 700;
  }
  .m-sheet-link {
    margin-left: auto;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .m-sheet-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    color: var(--color-muted);
  }
  .m-sheet-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem 1.25rem 2.5rem;
  }
  .m-loading {
    padding: 3rem 0;
    text-align: center;
    color: var(--color-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .m-home.is-behind {
      transform: none;
      filter: none;
      opacity: 1;
    }
  }
</style>
