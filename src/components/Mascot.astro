---
// Desktop mascot: two stacked images cross-fade between poses. Hidden until src/scripts/mascot.ts
// starts it, so phones, print and no-JavaScript visitors never see or download it. It is the way into
// the chat with the website agent; the speech bubble introduces it.
---

<div class="mascot-wrap" data-mascot-wrap hidden>
  <div class="mascot-tip" data-mascot-tip hidden>
    <p class="mascot-say" data-mascot-say></p>
    <button type="button" class="mascot-tip-close" data-mascot-dismiss aria-label="Ẩn lời chào">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>
  <button
    type="button"
    class="mascot"
    data-mascot
    data-pose="idle"
    aria-label="Trò chuyện với Agent DũngTQ"
    aria-controls="chat-panel"
    aria-expanded="false"
  >
    <img alt="" width="128" height="128" class="is-front" data-mascot-img />
    <img alt="" width="128" height="128" data-mascot-img />
  </button>
</div>

<style is:global>
  .mascot-wrap {
    position: absolute;
    right: 24px;
    bottom: 84px;
    z-index: 950;
    width: 128px;
    height: 128px;
    pointer-events: none;
    will-change: transform;
  }
  .mascot-wrap[hidden] {
    display: none;
  }
  .mascot {
    position: relative;
    display: block;
    width: 128px;
    height: 128px;
    border-radius: 24px;
    pointer-events: auto;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .mascot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .mascot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    filter: drop-shadow(0 10px 12px rgb(94 68 19 / 0.22));
    /* Turning around flips over a moment instead of snapping. */
    transition:
      opacity 200ms var(--os-ease),
      transform 180ms var(--os-ease);
  }
  .mascot img.is-front {
    opacity: 1;
  }
  .mascot-wrap[data-dir='left'] .mascot img {
    transform: scaleX(-1);
  }
  /* Small steps while walking: a bob and a sway from the feet, replacing the idle breath. */
  .mascot-wrap[data-walking] .mascot img {
    animation: mascot-step 0.42s ease-in-out infinite alternate;
    transform-origin: 50% 100%;
  }
  @keyframes mascot-step {
    from {
      translate: 0 0;
      rotate: -2deg;
    }
    to {
      translate: 0 -4px;
      rotate: 2deg;
    }
  }
  /* A slow breath while idle, on the images only so the button itself stays put under the pointer. */
  .mascot[data-pose='idle'] img {
    animation: mascot-breathe 3.2s ease-in-out infinite;
    transform-origin: 50% 100%;
  }
  .mascot[data-pose='sleep'] img {
    filter: drop-shadow(0 10px 12px rgb(94 68 19 / 0.22)) brightness(0.85);
  }
  .mascot-tip {
    position: absolute;
    right: 8px;
    bottom: calc(100% + 6px);
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
    width: max-content;
    max-width: 17rem;
    padding: 0.625rem 0.375rem 0.625rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 14px 14px 4px 14px;
    background: var(--color-panel);
    color: var(--color-ink);
    font-size: 0.8125rem;
    line-height: 1.45;
    box-shadow: var(--shadow-lift);
    pointer-events: auto;
    transform-origin: 100% 100%;
    animation: mascot-tip 240ms var(--os-spring);
  }
  .mascot-tip[hidden] {
    display: none;
  }
  .mascot-say {
    cursor: pointer;
  }
  .mascot-tip-close {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: -2px;
    border-radius: 999px;
    color: var(--color-muted);
  }
  .mascot-tip-close::after {
    content: '';
    position: absolute;
    inset: -10px;
  }
  .mascot-tip-close:hover {
    background: var(--color-tint);
    color: var(--color-ink);
  }
  .mascot-tip-close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .mascot-wrap[data-tip='right'] .mascot-tip {
    right: auto;
    left: 8px;
    border-radius: 14px 14px 14px 4px;
    transform-origin: 0 100%;
  }
  @keyframes mascot-breathe {
    50% {
      translate: 0 -2px;
      scale: 1.015 0.99;
    }
  }
  @keyframes mascot-tip {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
  }
  @media print {
    .mascot-wrap {
      display: none;
    }
  }
</style>
