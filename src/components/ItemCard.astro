---
import { env } from 'cloudflare:workers';
import { mediaUrl, type Item } from '../lib/content';

interface Props {
  item: Item;
}

const { item } = Astro.props;
const hasCover = item.coverKey
  ? Boolean(await env.MEDIA?.head?.(item.coverKey).catch(() => null))
  : false;
---

<article class="lux-card flex flex-col gap-3 p-6">
  {
    item.coverKey &&
      (hasCover ? (
        <img
          src={mediaUrl(item.coverKey)}
          alt={item.title}
          width="640"
          height="360"
          loading="lazy"
          decoding="async"
          class="aspect-video w-full rounded-xl border border-line object-cover"
        />
      ) : (
        <div class="media-fallback" role="img" aria-label={item.title}>
          <span class="media-fallback-mark">{item.kind === 'video' ? 'VIDEO AI' : 'TQD SKILL'}</span>
          <span class="media-fallback-caption">{item.title}</span>
        </div>
      ))
  }
  <div>
    {item.date && <p class="font-mono text-xs text-muted">{item.date}</p>}
    <h3 class="display mt-1 text-2xl">{item.title}</h3>
  </div>
  <p class="text-sm leading-relaxed">{item.summary}</p>
  <ul class="mt-auto flex flex-wrap gap-1.5" aria-label="Nhãn">
    {item.tags.map((t) => <li class="lux-chip px-2.5 py-0.5 text-xs">{t}</li>)}
  </ul>
  {
    item.links && item.links.length > 0 && (
      <p class="flex flex-wrap gap-3 text-sm font-semibold">
        {item.links.map((l) => (
          <a
            href={l.href}
            class="inline-flex min-h-11 -my-2 items-center"
            {...(l.href.startsWith('/') ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
          >
            {l.label} →
          </a>
        ))}
      </p>
    )
  }
</article>
