---
import type { Item } from '../data/profile';

interface Props {
  item: Item;
}

const { item } = Astro.props;
---

<article class="flex flex-col gap-3 rounded-xl border border-line bg-panel p-5">
  <div>
    <h3 class="text-base font-semibold leading-snug">{item.title}</h3>
    {item.date && <p class="mt-1 font-mono text-xs text-muted">{item.date}</p>}
  </div>
  <p class="text-sm leading-relaxed">{item.summary}</p>
  <ul class="mt-auto flex flex-wrap gap-1.5" aria-label="Nhãn">
    {item.tags.map((t) => <li class="rounded-full bg-paper px-2.5 py-0.5 text-xs text-muted ring-1 ring-line">{t}</li>)}
  </ul>
  {
    item.links && (
      <p class="flex flex-wrap gap-3 text-sm font-semibold">
        {item.links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener">
            {l.label} →
          </a>
        ))}
      </p>
    )
  }
</article>
