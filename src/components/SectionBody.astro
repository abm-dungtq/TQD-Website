---
import ItemCard from './ItemCard.astro';
import TikTokPlayer from './TikTokPlayer.astro';
import { introParagraphs, isVideoKey, mediaUrl, type SectionId, type SiteData } from '../lib/content';

interface Props {
  id: SectionId;
  data: SiteData;
  /** Loads the portrait eagerly when it is above the fold. */
  eager?: boolean;
}

const { id, data, eager = false } = Astro.props;
const { person, links, topics, gallery } = data.site;
const { products, videos, articles } = data;
const gridClass = 'grid gap-4 sm:grid-cols-2';
const formatDate = (iso?: string) => (iso ? iso.slice(0, 10).split('-').reverse().join('/') : '');
---

{
  id === 'ho-so' && (
    <div class="grid items-start gap-8 sm:grid-cols-[13rem_1fr]">
      <img
        src={person.portrait}
        srcset={`${person.portraitSmall} 240w, ${person.portrait} 480w`}
        sizes="(min-width: 640px) 208px, 60vw"
        width="240"
        height="320"
        alt={person.portraitAlt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        class="lux-portrait aspect-[3/4] w-3/5 max-w-[13rem] object-cover sm:w-full"
      />
      <div class="flex flex-col gap-4">
        <div>
          <h2 class="display text-4xl sm:text-5xl">{person.name}</h2>
          <p class="mt-3 text-muted">{person.role}</p>
        </div>
        {introParagraphs(person.intro).map((p) => (
          <p class="max-w-prose text-[1.0625rem] leading-relaxed">{p}</p>
        ))}
        <ul class="flex flex-wrap gap-2">
          {person.focus.map((f) => (
            <li class="lux-chip px-3.5 py-1.5 text-sm">{f}</li>
          ))}
        </ul>
      </div>
    </div>
  )
}

{
  id === 'san-pham' && (
    <div class={gridClass}>
      {products.map((item) => (
        <ItemCard item={item} />
      ))}
    </div>
  )
}

{
  id === 'thu-vien' && (
    <div class={gridClass}>
      {gallery.map((g) => (
        <figure class="lux-card gallery-item">
          {isVideoKey(g.key) ? (
            <video
              src={mediaUrl(g.key)}
              poster={g.poster ? mediaUrl(g.poster) : undefined}
              controls
              playsinline
              preload="none"
              width="1280"
              height="720"
              aria-label={g.caption}
            />
          ) : (
            <a href={mediaUrl(g.key)} target="_blank" rel="noopener" aria-label={`Xem ảnh lớn: ${g.caption}`}>
              <img src={mediaUrl(g.key)} alt={g.caption} width="1280" height="720" loading="lazy" decoding="async" />
            </a>
          )}
          <figcaption class="p-4 text-sm leading-relaxed">{g.caption}</figcaption>
        </figure>
      ))}
    </div>
  )
}

{
  id === 'video-ai' && (
    <div class={gridClass}>
      {videos.map((item) =>
        item.tiktokId ? (
          <article class="flex flex-col gap-3">
            <TikTokPlayer id={item.tiktokId} title={item.title} coverUrl={item.coverKey ? mediaUrl(item.coverKey) : undefined} />
            <h3 class="font-semibold">{item.title}</h3>
            <p class="text-sm text-muted">{item.summary}</p>
          </article>
        ) : (
          <ItemCard item={item} />
        ),
      )}
    </div>
  )
}

{
  id === 'bai-viet' && articles.length > 0 && (
    <ul class="flex flex-col gap-4">
      {articles.map((a) => (
        <li class="lux-card p-6">
          <p class="font-mono text-xs text-muted">{formatDate(a.publishedAt)}</p>
          <h3 class="display mt-2 text-2xl">
            <a href={`/bai-viet/${a.slug}`} class="text-ink no-underline hover:text-accent-ink">
              {a.title}
            </a>
          </h3>
          {a.summary && <p class="mt-2 text-sm leading-relaxed">{a.summary}</p>}
        </li>
      ))}
    </ul>
  )
}

{
  id === 'bai-viet' && articles.length === 0 && (
    <div class="flex flex-col gap-6">
      <p class="text-muted">Chưa có bài viết.</p>
      <h2 class="display text-3xl">Chủ đề thường viết</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="lux-card p-6">
          <h3 class="mb-3 text-base font-semibold">Hướng dẫn &amp; quy trình</h3>
          <ul class="list-disc space-y-1.5 pl-5 text-sm">
            {topics.howTo.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
        <div class="lux-card p-6">
          <h3 class="mb-3 text-base font-semibold">Theo dõi thị trường</h3>
          <ul class="list-disc space-y-1.5 pl-5 text-sm">
            {topics.marketWatch.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  )
}

{
  id === 'lien-he' && (
    <div class="flex flex-col gap-6">
      <p class="max-w-prose text-[1.0625rem] leading-relaxed">Cần trao đổi về ứng dụng AI cho doanh nghiệp, đào tạo hay skill, agent? Nhắn mình qua:</p>
      <dl class="grid gap-3 sm:grid-cols-2">
        <div class="lux-card p-6">
          <dt class="text-sm text-muted">Email</dt>
          <dd class="display mt-2 text-2xl break-all">
            <a href={`mailto:${person.email}`}>{person.email}</a>
          </dd>
        </div>
        <div class="lux-card p-6">
          <dt class="text-sm text-muted">Zalo</dt>
          <dd class="display mt-2 text-2xl break-all">
            <a href={person.zalo} target="_blank" rel="noopener">
              {person.zalo.replace('https://', '')}
            </a>
          </dd>
        </div>
      </dl>
      <ul class="flex flex-wrap gap-3">
        {links
          .filter((l) => l.label !== 'Email' && l.label !== 'Zalo')
          .map((l) => (
            <li>
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                class="lux-card inline-flex min-h-11 items-center rounded-full px-5 font-semibold no-underline"
              >
                {l.label}
              </a>
            </li>
          ))}
      </ul>
    </div>
  )
}
