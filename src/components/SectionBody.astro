---
import ItemCard from './ItemCard.astro';
import StatGrid from './StatGrid.astro';
import TikTokPlayer from './TikTokPlayer.astro';
import { mediaUrl, type SectionId, type SiteData } from '../lib/content';

interface Props {
  id: SectionId;
  data: SiteData;
  /** Loads the portrait eagerly when it is above the fold. */
  eager?: boolean;
}

const { id, data, eager = false } = Astro.props;
const { person, links, topics, stats } = data.site;
const { products, trainings, videos, articles } = data;
const gridClass = 'grid gap-4 sm:grid-cols-2';
const formatDate = (iso?: string) => (iso ? iso.slice(0, 10).split('-').reverse().join('/') : '');
---

{
  id === 'ho-so' && (
    <div class="grid items-start gap-8 sm:grid-cols-[13rem_1fr]">
      <img
        src={person.portrait}
        srcset={`${person.portraitSmall} 240w, ${person.portrait} 480w`}
        sizes="(min-width: 640px) 208px, 60vw"
        width="240"
        height="320"
        alt={person.portraitAlt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        class="aspect-[3/4] w-3/5 max-w-[13rem] rounded-2xl object-cover ring-1 ring-line sm:w-full"
      />
      <div class="flex flex-col gap-4">
        <div>
          <h2 class="text-2xl font-bold tracking-tight">{person.name}</h2>
          <p class="mt-1 text-muted">{person.role}</p>
        </div>
        <p class="leading-relaxed">{person.intro}</p>
        <ul class="flex flex-wrap gap-2">
          {person.focus.map((f) => (
            <li class="rounded-full bg-accent/10 px-3 py-1 text-sm text-accent-ink">{f}</li>
          ))}
        </ul>
      </div>
    </div>
  )
}

{
  id === 'san-pham' && (
    <div class={gridClass}>
      {products.map((item) => (
        <ItemCard item={item} />
      ))}
    </div>
  )
}

{
  id === 'dao-tao' && (
    <div class={gridClass}>
      {trainings.map((item) => (
        <ItemCard item={item} />
      ))}
    </div>
  )
}

{
  id === 'video-ai' && (
    <div class={gridClass}>
      {videos.map((item) =>
        item.tiktokId ? (
          <article class="flex flex-col gap-3">
            <TikTokPlayer id={item.tiktokId} title={item.title} coverUrl={item.coverKey ? mediaUrl(item.coverKey) : undefined} />
            <h3 class="font-semibold">{item.title}</h3>
            <p class="text-sm text-muted">{item.summary}</p>
          </article>
        ) : (
          <ItemCard item={item} />
        ),
      )}
    </div>
  )
}

{
  id === 'bai-viet' && articles.length > 0 && (
    <ul class="flex flex-col gap-4">
      {articles.map((a) => (
        <li class="rounded-xl border border-line bg-panel p-5">
          <h3 class="text-base font-semibold leading-snug">
            <a href={`/bai-viet/${a.slug}`}>{a.title}</a>
          </h3>
          <p class="mt-1 font-mono text-xs text-muted">{formatDate(a.publishedAt)}</p>
          {a.summary && <p class="mt-2 text-sm leading-relaxed">{a.summary}</p>}
        </li>
      ))}
    </ul>
  )
}

{
  id === 'bai-viet' && articles.length === 0 && (
    <div class="flex flex-col gap-6">
      <p class="text-muted">Chưa có bài viết.</p>
      <h2 class="text-lg font-semibold">Chủ đề thường viết</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-line bg-panel p-5">
          <h2 class="mb-3 text-base font-semibold">Hướng dẫn &amp; quy trình</h2>
          <ul class="list-disc space-y-1.5 pl-5 text-sm">
            {topics.howTo.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-line bg-panel p-5">
          <h2 class="mb-3 text-base font-semibold">Theo dõi thị trường</h2>
          <ul class="list-disc space-y-1.5 pl-5 text-sm">
            {topics.marketWatch.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  )
}

{id === 'so-lieu' && <StatGrid stats={stats} />}

{
  id === 'lien-he' && (
    <div class="flex flex-col gap-6">
      <p class="leading-relaxed">Cần trao đổi về ứng dụng AI cho doanh nghiệp, đào tạo hay skill, agent? Nhắn mình qua:</p>
      <dl class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-line bg-panel p-5">
          <dt class="text-sm text-muted">Email</dt>
          <dd class="mt-1 text-lg font-semibold">
            <a href={`mailto:${person.email}`}>{person.email}</a>
          </dd>
        </div>
        <div class="rounded-xl border border-line bg-panel p-5">
          <dt class="text-sm text-muted">Zalo</dt>
          <dd class="mt-1 text-lg font-semibold">
            <a href={person.zalo} target="_blank" rel="noopener">
              {person.zalo.replace('https://', '')}
            </a>
          </dd>
        </div>
      </dl>
      <ul class="flex flex-wrap gap-3">
        {links
          .filter((l) => l.label !== 'Email' && l.label !== 'Zalo')
          .map((l) => (
            <li>
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                class="inline-block rounded-lg border border-line bg-panel px-4 py-2 font-semibold no-underline hover:border-accent"
              >
                {l.label}
              </a>
            </li>
          ))}
      </ul>
    </div>
  )
}
