---
// Editorial page heading: mono index and champagne rule above a serif title and a short lede.
interface Props {
  index?: number;
  label?: string;
  title: string;
  lede?: string;
}

const { index, label, title, lede } = Astro.props;
---

<header class="mb-10 sm:mb-14">
  {
    (index || label) && (
      <p class="eyebrow mb-4">
        {index && <span class="eyebrow-index">{String(index).padStart(2, '0')}</span>}
        <span class="eyebrow-rule" aria-hidden="true" />
        {label && <span>{label}</span>}
      </p>
    )
  }
  <h1 class="display text-[2.5rem] sm:text-6xl">{title}</h1>
  {lede && <p class="mt-4 max-w-2xl text-lg text-muted">{lede}</p>}
</header>
