---
import type { Stats } from '../lib/content';

interface Props {
  stats: Stats;
}

const { stats } = Astro.props;
const byGroupTotal = stats.byGroup.reduce((sum, g) => sum + g.count, 0);
const byGroupMax = Math.max(1, ...stats.byGroup.map((g) => g.count));
---

<div class="flex flex-col gap-8">
  <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    {
      stats.headline.map((s) => (
        <div class="lux-card p-5">
          <dt class="text-sm text-muted">{s.label}</dt>
          <dd class="display mt-2 text-5xl">
            <span class="stat-value">{s.value}</span>
          </dd>
          {s.note && <dd class="text-xs text-muted">{s.note}</dd>}
        </div>
      ))
    }
  </dl>
  <div>
    <h3 class="display mb-4 text-2xl">Bài về AI theo nhóm</h3>
    <ul class="flex flex-col gap-2.5">
      {
        stats.byGroup.map((g) => (
          <li class="grid grid-cols-[minmax(0,12rem)_1fr_2.5rem] items-center gap-3 text-sm">
            <span class="truncate">{g.label}</span>
            <span class="h-1.5 rounded-full bg-tint" aria-hidden="true">
              <span class="block h-full rounded-full bg-gradient-to-r from-champagne to-accent" style={`width:${(g.count / byGroupMax) * 100}%`} />
            </span>
            <span class="text-right font-mono">{g.count}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-sm text-muted">Tổng: <span class="font-mono">{byGroupTotal}</span> bài</p>
  </div>
  <p class="text-sm text-muted">Giai đoạn {stats.period}. {stats.source}</p>
</div>
