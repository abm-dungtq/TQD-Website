---
// Chat with the website agent. The markup is static and hidden: src/scripts/chat-panel.ts loads on the
// first open (the mascot on desktop, the round button on phones), so nothing is fetched before that.
interface Props {
  zalo: string;
}

const { zalo } = Astro.props;
---

<button type="button" class="chat-fab" data-chat-fab aria-label="Trò chuyện với Agent DũngTQ" aria-controls="chat-panel" aria-expanded="false" hidden>
  <img src="/mascot/idle.webp" alt="" width="128" height="128" loading="lazy" decoding="async" />
</button>

<div class="chat-scrim" data-chat-scrim hidden></div>
<section id="chat-panel" class="chat-panel" role="dialog" aria-labelledby="chat-title" data-chat data-zalo={zalo} tabindex="-1" hidden>
  <header class="chat-head" data-chat-drag>
    <span class="chat-handle" aria-hidden="true"></span>
    <img class="chat-avatar" alt="" width="40" height="40" data-chat-avatar />
    <div class="min-w-0">
      <h2 id="chat-title" class="chat-title">Agent DũngTQ</h2>
      <p class="chat-sub" data-chat-sub>Phiên bản AI của DũngTQ</p>
    </div>
    <button type="button" class="chat-icon-btn ml-auto" data-chat-new title="Cuộc trò chuyện mới" aria-label="Cuộc trò chuyện mới">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
      </svg>
    </button>
    <button type="button" class="chat-icon-btn" data-chat-close aria-label="Đóng">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </header>

  <div class="chat-log" role="log" aria-live="polite" aria-label="Hội thoại" data-chat-log></div>

  <div class="chat-offline" data-chat-offline hidden>
    <p>Agent đang nghỉ, bạn có thể nhắn Zalo cho DũngTQ.</p>
    <div class="chat-offline-actions">
      <a class="chat-zalo" href={zalo} target="_blank" rel="noopener">Nhắn Zalo</a>
      <button type="button" class="chat-retry" data-chat-retry>Thử lại</button>
    </div>
  </div>

  <form class="chat-form" data-chat-form>
    <label for="chat-input" class="sr-only">Tin nhắn cho Agent DũngTQ</label>
    <textarea id="chat-input" class="chat-input" rows="1" maxlength="1000" placeholder="Hỏi về AI, agent, sản phẩm…" data-chat-input></textarea>
    <button type="submit" class="chat-send" data-chat-send aria-label="Gửi" disabled>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>
  </form>
  <p class="chat-note">Tin nhắn được gửi tới agent AI của DũngTQ và được lưu để tiếp nối hội thoại; đừng gửi thông tin cá nhân.</p>
</section>

<script>
  // Phones get the round button; the panel script itself loads on the first tap.
  const fab = document.querySelector<HTMLButtonElement>('[data-chat-fab]');
  if (fab) {
    fab.hidden = false;
    fab.addEventListener('click', () => {
      import('../scripts/chat-panel').then((m) => m.toggleChat(fab)).catch(() => {});
    });
  }
</script>

<style is:global>
  .chat-fab {
    position: fixed;
    isolation: isolate;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 1000;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: radial-gradient(circle at 50% 30%, var(--color-panel), var(--color-tint));
    box-shadow: var(--shadow-lift);
    -webkit-tap-highlight-color: transparent;
    transition: transform 150ms var(--os-ease);
  }
  /* The pose image is a full figure; enlarge it so the face fills the circle. */
  .chat-fab img {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 76px;
    height: 76px;
    max-width: none;
    object-fit: contain;
    transform: translateX(-50%);
  }
  .chat-fab:active {
    transform: scale(0.94);
  }
  .chat-fab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .chat-fab[hidden] {
    display: none;
  }
  /* Wide screens talk through the mascot; the button only returns when the mascot is switched off. */
  @media (min-width: 1024px) {
    html:not([data-mascot='off']) .chat-fab {
      display: none;
    }
  }

  .chat-scrim {
    position: fixed;
    inset: 0;
    z-index: 1090;
    background: rgb(27 32 48 / 0.18);
  }
  .chat-scrim[hidden],
  .chat-panel[hidden] {
    display: none;
  }
  .chat-panel {
    position: fixed;
    right: 168px;
    bottom: 84px;
    z-index: 1010;
    display: flex;
    flex-direction: column;
    width: min(400px, calc(100vw - 200px));
    height: min(600px, calc(100vh - 140px));
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 18px;
    background: var(--color-panel);
    color: var(--color-ink);
    box-shadow: var(--shadow-lift);
    outline: none;
    transform-origin: 100% 100%;
  }
  html[data-mascot='off'] .chat-panel {
    right: 24px;
  }
  .chat-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 0.5rem 0.875rem 1rem;
    border-bottom: 1px solid var(--color-line);
    background: linear-gradient(180deg, var(--color-tint), var(--color-panel));
  }
  .chat-handle {
    display: none;
  }
  .chat-avatar {
    flex: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-panel);
    object-fit: cover;
    object-position: 50% 12%;
  }
  .chat-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .chat-sub {
    overflow: hidden;
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .chat-icon-btn {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    color: var(--color-muted);
    transition:
      background-color 150ms var(--os-ease),
      color 150ms var(--os-ease);
  }
  .chat-icon-btn:hover {
    background: var(--color-tint);
    color: var(--color-ink);
  }
  .chat-icon-btn:disabled {
    opacity: 0.4;
    pointer-events: none;
  }
  .chat-log {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1rem;
    scroll-behavior: smooth;
  }
  .chat-msg {
    max-width: 88%;
    padding: 0.625rem 0.875rem;
    border-radius: 16px;
    font-size: 0.9rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .chat-msg > * + * {
    margin-top: 0.5rem;
  }
  .chat-msg ul,
  .chat-msg ol {
    padding-left: 1.25rem;
  }
  .chat-msg ul {
    list-style: disc;
  }
  .chat-msg ol {
    list-style: decimal;
  }
  .chat-msg strong {
    font-weight: 650;
  }
  .chat-msg a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .chat-msg[data-role='user'] {
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    background: var(--color-tint);
    white-space: pre-wrap;
  }
  .chat-msg[data-role='agent'] {
    align-self: flex-start;
    border: 1px solid var(--color-line);
    border-bottom-left-radius: 4px;
    background: var(--color-panel);
  }
  .chat-msg[data-role='error'] {
    align-self: flex-start;
    border: 1px dashed color-mix(in srgb, var(--color-accent) 45%, var(--color-line));
    background: color-mix(in srgb, var(--color-tint) 60%, var(--color-panel));
    color: var(--color-accent-ink);
  }
  .chat-dots {
    display: inline-flex;
    gap: 4px;
    padding: 0.35rem 0;
  }
  .chat-dots span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-champagne);
    animation: chat-dot 1.1s ease-in-out infinite;
  }
  .chat-dots span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .chat-dots span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes chat-dot {
    0%,
    80%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }
  .chat-offline {
    margin: 0 1rem 0.75rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-tint);
    font-size: 0.875rem;
  }
  .chat-offline[hidden] {
    display: none;
  }
  .chat-offline-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.625rem;
  }
  .chat-zalo,
  .chat-retry {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .chat-zalo {
    background: var(--color-accent);
    color: #fff;
    text-decoration: none;
  }
  .chat-retry {
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    color: var(--color-ink);
  }
  .chat-form {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    margin: 0 1rem;
    padding: 0.375rem 0.375rem 0.375rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 18px;
    background: var(--color-panel);
    transition: border-color 150ms var(--os-ease);
  }
  .chat-form:focus-within {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-line));
  }
  .chat-input {
    flex: 1;
    min-height: 32px;
    max-height: 132px;
    padding: 0.375rem 0;
    resize: none;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-ink);
    outline: none;
  }
  .chat-input::placeholder {
    color: var(--color-muted);
  }
  .chat-send {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    transition:
      opacity 150ms var(--os-ease),
      transform 150ms var(--os-ease);
  }
  .chat-send:active {
    transform: scale(0.92);
  }
  .chat-send:disabled {
    opacity: 0.35;
  }
  .chat-icon-btn:focus-visible,
  .chat-send:focus-visible,
  .chat-zalo:focus-visible,
  .chat-retry:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .chat-note {
    padding: 0.5rem 1rem 0.875rem;
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--color-muted);
  }

  /* Phones: a sheet from the bottom, like the section sheets on the home screen. */
  @media (max-width: 1023px) {
    .chat-panel,
    html[data-mascot='off'] .chat-panel {
      inset: auto 0 0 0;
      z-index: 1100;
      width: auto;
      height: 92dvh;
      border: 0;
      border-radius: 18px 18px 0 0;
      box-shadow: 0 -20px 50px -24px rgb(94 68 19 / 0.4);
    }
    .chat-head {
      padding-top: 1.25rem;
      touch-action: none;
      user-select: none;
    }
    .chat-handle {
      position: absolute;
      top: 8px;
      left: 50%;
      display: block;
      width: 40px;
      height: 4px;
      border-radius: 999px;
      background: var(--color-line);
      transform: translateX(-50%);
    }
    .chat-icon-btn {
      width: 44px;
      height: 44px;
    }
    .chat-send {
      width: 44px;
      height: 44px;
    }
    .chat-input {
      font-size: 1rem;
    }
    .chat-note {
      padding-bottom: calc(0.875rem + env(safe-area-inset-bottom));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-dots span {
      animation: none;
      opacity: 0.6;
    }
    .chat-log {
      scroll-behavior: auto;
    }
  }
  @media print {
    .chat-fab,
    .chat-panel,
    .chat-scrim {
      display: none !important;
    }
  }
</style>
