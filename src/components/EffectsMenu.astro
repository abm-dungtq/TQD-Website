---
// "Hiệu ứng" menu in the desktop menu bar: switches for the mascot and the weather effect.
// Hidden until src/scripts/effects-menu.ts runs, since both effects need JavaScript.
---

<div class="fx-menu" data-effects-menu hidden>
  <button type="button" class="fx-trigger" data-effects-trigger aria-expanded="false" aria-controls="effects-panel">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M12 3.5 13.9 9l5.6 1.1-4.3 3.6 1 5.8L12 16.6l-4.2 2.9 1-5.8-4.3-3.6L10.1 9Z" stroke-linejoin="round"></path>
    </svg>
    Hiệu ứng
  </button>
  <div id="effects-panel" class="fx-panel" data-effects-panel hidden>
    <fieldset>
      <legend>Hiệu ứng</legend>
      <label class="fx-switch">
        <span>Linh vật</span>
        <input type="checkbox" role="switch" data-pref="tqd-mascot" />
      </label>
      <label class="fx-switch">
        <span>Hiệu ứng thời tiết</span>
        <input type="checkbox" role="switch" data-pref="tqd-weather-fx" />
      </label>
    </fieldset>
  </div>
</div>

<script>
  import '../scripts/effects-menu.ts';
</script>

<style>
  .fx-menu {
    position: relative;
  }
  .fx-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 28px;
    padding: 0 0.5rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    color: var(--color-ink);
    cursor: pointer;
  }
  .fx-trigger:hover,
  .fx-trigger[aria-expanded='true'] {
    background: color-mix(in srgb, var(--color-champagne) 14%, transparent);
  }
  .fx-panel {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 1500;
    width: 15rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-panel);
    box-shadow: var(--shadow-lift);
    transform-origin: top right;
    animation: fx-pop 200ms var(--os-ease);
  }
  .fx-panel[hidden] {
    display: none;
  }
  legend {
    margin-bottom: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .fx-switch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .fx-switch input {
    appearance: none;
    position: relative;
    width: 36px;
    height: 20px;
    margin: 0;
    border-radius: 999px;
    background: var(--color-line);
    cursor: pointer;
    transition: background-color 200ms var(--os-ease);
  }
  .fx-switch input::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(94 68 19 / 0.3);
    transition: transform 200ms var(--os-spring);
  }
  .fx-switch input:checked {
    background: var(--color-accent);
  }
  .fx-switch input:checked::after {
    transform: translateX(16px);
  }
  @keyframes fx-pop {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
</style>
