---
// Theme and accent picker. Hidden until src/scripts/theme.ts runs, since it needs JavaScript.
interface Props {
  /** Unique per page; two menus share the home page (desktop menubar and plain header). */
  id: string;
  /** Opens the panel upward-right of the trigger instead of below-left. */
  align?: 'start' | 'end';
  /** Adds switches for the desktop-only effects (mascot, weather). */
  effects?: boolean;
}

const { id, align = 'end', effects = false } = Astro.props;
const modes = [
  { value: 'light', label: 'Sáng' },
  { value: 'dark', label: 'Tối' },
  { value: 'auto', label: 'Tự động' },
];
const accents = [
  { value: 'blue', label: 'Xanh dương', swatch: '#2563eb' },
  { value: 'violet', label: 'Tím', swatch: '#7c3aed' },
  { value: 'emerald', label: 'Xanh lục', swatch: '#047857' },
  { value: 'amber', label: 'Hổ phách', swatch: '#b45309' },
  { value: 'rose', label: 'Hồng', swatch: '#e11d48' },
];
---

<div class="theme-menu" data-theme-menu hidden>
  <button type="button" class="theme-trigger" data-theme-trigger aria-expanded="false" aria-controls={`${id}-panel`}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <circle cx="12" cy="12" r="8.5"></circle>
      <path d="M12 3.5v17a8.5 8.5 0 0 0 0-17Z" fill="currentColor"></path>
    </svg>
    Giao diện
  </button>
  <div id={`${id}-panel`} class:list={['theme-panel', align === 'start' && 'theme-panel-start']} data-theme-panel hidden>
    <fieldset>
      <legend>Chế độ</legend>
      <div class="theme-segment">
        {
          modes.map((m) => (
            <label>
              <input type="radio" name={`${id}-mode`} value={m.value} data-mode />
              <span>{m.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend>Màu nhấn</legend>
      <div class="theme-swatches">
        {
          accents.map((a) => (
            <label class="theme-swatch" style={`--swatch:${a.swatch}`}>
              <input type="radio" name={`${id}-accent`} value={a.value} data-accent aria-label={a.label} />
            </label>
          ))
        }
      </div>
    </fieldset>
    {
      effects && (
        <fieldset>
          <legend>Hiệu ứng</legend>
          <label class="theme-switch">
            <span>Linh vật</span>
            <input type="checkbox" role="switch" data-pref="tqd-mascot" />
          </label>
          <label class="theme-switch">
            <span>Hiệu ứng thời tiết</span>
            <input type="checkbox" role="switch" data-pref="tqd-weather-fx" />
          </label>
        </fieldset>
      )
    }
  </div>
</div>

<script>
  import '../scripts/theme.ts';
</script>

<style>
  .theme-menu {
    position: relative;
  }
  .theme-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 28px;
    padding: 0 0.5rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    color: var(--color-ink);
    cursor: pointer;
  }
  .theme-trigger:hover,
  .theme-trigger[aria-expanded='true'] {
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  .theme-panel {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 1500;
    display: grid;
    gap: 0.75rem;
    width: 15rem;
    padding: 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-panel);
    box-shadow: 0 18px 40px -16px rgb(15 23 42 / 0.35);
    transform-origin: top right;
    animation: theme-pop 200ms var(--os-ease);
  }
  .theme-panel-start {
    right: auto;
    left: 0;
    transform-origin: top left;
  }
  .theme-panel[hidden] {
    display: none;
  }
  legend {
    margin-bottom: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .theme-segment {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 2px;
    border-radius: 8px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }
  .theme-segment label {
    position: relative;
  }
  .theme-segment input,
  .theme-swatch input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .theme-segment span {
    display: grid;
    place-items: center;
    min-height: 32px;
    border-radius: 6px;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .theme-segment input:checked + span {
    background: var(--color-panel);
    color: var(--color-ink);
    font-weight: 600;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.12);
  }
  .theme-segment input:focus-visible + span,
  .theme-swatch:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .theme-swatches {
    display: flex;
    gap: 0.5rem;
  }
  .theme-swatch {
    position: relative;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--swatch);
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.25);
  }
  .theme-swatch:has(input:checked) {
    box-shadow:
      0 0 0 2px var(--color-panel),
      0 0 0 4px var(--swatch);
  }
  .theme-switch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 36px;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .theme-switch input {
    appearance: none;
    position: relative;
    width: 36px;
    height: 20px;
    margin: 0;
    border-radius: 999px;
    background: var(--color-line);
    cursor: pointer;
    transition: background-color 200ms var(--os-ease);
  }
  .theme-switch input::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.25);
    transition: transform 200ms var(--os-spring);
  }
  .theme-switch input:checked {
    background: var(--color-accent);
  }
  .theme-switch input:checked::after {
    transform: translateX(16px);
  }
  .theme-switch input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @keyframes theme-pop {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
</style>
