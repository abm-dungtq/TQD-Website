---
// Home-page "desktop": a menu bar, quick B2B shortcuts on the left rail, a unified bottom dock
// for the 7 app sections, and one draggable window per section.
import { env } from 'cloudflare:workers';
import Icon from './Icon.astro';
import EffectsMenu from './EffectsMenu.astro';
import SectionBody from './SectionBody.astro';
import Mascot from './Mascot.astro';
import FeaturedVideo from './FeaturedVideo.astro';
import { featuredVideo, type SiteData } from '../lib/content';

interface Props {
  data: SiteData;
}

const { data } = Astro.props;
const { person, sections } = data.site;
const primaryZalo = person.zalo || 'https://zalo.me/trinhquangdung';
const featured = featuredVideo(data.site.gallery);
const hasFeaturedMedia = featured
  ? Boolean(await env.MEDIA?.head?.(featured.key).catch(() => null))
  : false;
---

<div id="desktop" class="desktop hidden" data-desktop tabindex="-1">
  <h1 class="sr-only">{person.name} ({person.handle})</h1>
  <div class="desktop-wordmark" data-wordmark={person.handle} aria-hidden="true"></div>
  <div class="desktop-menubar">
    <a href="/" class="inline-flex min-h-9 items-center gap-2 font-semibold text-ink no-underline">
      <img src={person.portraitSmall} alt="" width="40" height="40" class="size-5 rounded-full object-cover" />
      <span>{person.handle}</span>
    </a>
    <span class="truncate text-muted">{person.role}</span>
    <div class="ml-auto flex items-center gap-1.5">
      <a
        href={primaryZalo}
        target="_blank"
        rel="noopener noreferrer"
        class="desktop-menu-btn font-semibold text-accent-ink no-underline"
      >
        <Icon name="chat" size={15} />
        <span>Tư vấn Zalo</span>
      </a>
      <a href="/tai-video" class="desktop-menu-btn font-semibold no-underline">
        <Icon name="download" size={15} />
        <span>Tải Video</span>
      </a>
      <button type="button" class="cmdk-trigger gradient-hover" data-cmdk-open hidden>
        Tìm <kbd>⌘K</kbd>
      </button>
      <button type="button" class="desktop-menu-btn" data-expose-toggle aria-pressed="false">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <rect x="3.5" y="4.5" width="7.5" height="6.5" rx="1.5"></rect><rect x="13" y="4.5" width="7.5" height="6.5" rx="1.5"></rect>
          <rect x="3.5" y="13" width="7.5" height="6.5" rx="1.5"></rect><rect x="13" y="13" width="7.5" height="6.5" rx="1.5"></rect>
        </svg>
        <span>Tất cả cửa sổ</span>
      </button>
      <span class="desktop-weather" data-weather hidden></span>
      <EffectsMenu />
      <time class="ml-1.5 font-mono" data-clock></time>
    </div>
  </div>

  {/* Non-duplicating B2B & AX quick actions in the 150px left strip; all 7 sections live in the bottom Dock. */}
  <aside class="desktop-launcher" aria-label="Lối tắt nhanh">
    <a
      href={primaryZalo}
      target="_blank"
      rel="noopener noreferrer"
      class="desktop-launch no-underline"
    >
      <span class="desktop-glyph gradient-hover grad-1">
        <Icon name="chat" size={24} />
      </span>
      <span class="text-center text-xs font-semibold leading-tight">Tư vấn AI<br />(Zalo)</span>
    </a>

    <button type="button" class="desktop-launch" data-chat-open>
      <span class="desktop-glyph gradient-hover grad-2">
        <Icon name="sparkles" size={24} />
      </span>
      <span class="text-center text-xs font-semibold leading-tight">Hỏi Agent<br />DũngTQ</span>
    </button>

    <a href="/tai-video" class="desktop-launch no-underline">
      <span class="desktop-glyph gradient-hover grad-3">
        <Icon name="dna" size={24} />
      </span>
      <span class="text-center text-xs font-semibold leading-tight">Xưởng Kịch<br />Bản Viral</span>
    </a>

    <a href="/llms-full.txt" class="desktop-launch no-underline" title="Toàn bộ kho tri thức Markdown dành cho AI Agent">
      <span class="desktop-glyph gradient-hover grad-4">
        <Icon name="file-text" size={24} />
      </span>
      <span class="text-center text-xs font-semibold leading-tight">Hồ sơ AI<br />(llms.txt)</span>
    </a>
  </aside>

  {
    sections.map((s) => (
      <section
        class="desktop-window"
        aria-labelledby={`win-title-${s.id}`}
        data-window={s.id}
        tabindex="-1"
        hidden
      >
        <header class="desktop-titlebar" data-drag>
          <span class="desktop-lights">
            <button type="button" class="desktop-light is-close" data-close aria-label="Đóng cửa sổ">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 3.5l5 5m0-5-5 5" /></svg>
            </button>
            <button type="button" class="desktop-light is-min" data-minimize aria-label="Thu nhỏ xuống thanh Dock">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 6h6" /></svg>
            </button>
            <button type="button" class="desktop-light is-max" data-maximize aria-label="Phóng to cửa sổ">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4 8V4h4M8 4 4 8" /></svg>
            </button>
          </span>
          <h2 id={`win-title-${s.id}`} class="text-sm font-semibold">
            {s.title}
          </h2>
          <a href={`/${s.id}`} class="ml-auto inline-flex min-h-11 items-center px-2 text-xs font-semibold">
            Mở trang riêng →
          </a>
        </header>
        <div class="desktop-body">
          <SectionBody id={s.id} data={data} />
        </div>
      </section>
    ))
  }

  {featured && hasFeaturedMedia && <FeaturedVideo video={featured} />}

  <div class="desktop-snap" data-snap-preview hidden></div>

  <Mascot />

  <nav class="desktop-dock" aria-label="Thanh ứng dụng chính">
    {
      sections.map((s, i) => (
        <button
          type="button"
          class={`desktop-dock-item gradient-hover grad-${(i % 4) + 1}`}
          data-open={s.id}
          aria-label={s.title}
        >
          <span class="desktop-dock-icon">
            <Icon name={s.icon} size={23} />
          </span>
          <span class="desktop-dock-label" aria-hidden="true">{s.title}</span>
          <span class="desktop-dock-dot" aria-hidden="true"></span>
        </button>
      ))
    }
    <a
      href="/tai-video"
      class="desktop-dock-item gradient-hover grad-3 no-underline"
      aria-label="Tải Video"
    >
      <span class="desktop-dock-icon">
        <Icon name="download" size={23} />
      </span>
      <span class="desktop-dock-label" aria-hidden="true">Tải Video</span>
    </a>
  </nav>
</div>

<script>
  import '../scripts/desktop.ts';
</script>

<style is:global>
  .desktop {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background-color: var(--color-paper);
  }
  /* Aurora wallpaper: champagne and pearl glows drifting slowly over a fine static dot grid. */
  .desktop::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(color-mix(in srgb, var(--color-champagne) 22%, transparent) 1px, transparent 1px),
      radial-gradient(38% 46% at 18% 28%, color-mix(in srgb, var(--color-champagne) 26%, transparent), transparent 70%),
      radial-gradient(34% 40% at 82% 18%, rgb(220 227 234 / 0.75), transparent 70%),
      radial-gradient(40% 44% at 70% 82%, color-mix(in srgb, var(--color-champagne) 18%, transparent), transparent 70%),
      radial-gradient(30% 36% at 30% 86%, rgb(232 228 240 / 0.7), transparent 70%);
    background-size:
      22px 22px,
      200% 200%,
      200% 200%,
      200% 200%,
      200% 200%;
    background-position:
      0 0,
      0% 0%,
      100% 0%,
      100% 100%,
      0% 100%;
    will-change: background-position;
    animation: aurora 28s ease-in-out infinite alternate;
    transition: opacity 1.2s var(--os-ease);
  }
  /* Moving wallpaper (src/scripts/wallpaper.ts): below every other layer; the aurora fades once it plays. */
  .desktop-wallpaper {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .desktop[data-wallpaper='video']::before {
    opacity: 0;
    animation-play-state: paused;
  }
  @keyframes aurora {
    to {
      background-position:
        0 0,
        60% 40%,
        30% 70%,
        20% 30%,
        80% 20%;
    }
  }
  /* A faint signature in the wallpaper; decorative, so champagne at low opacity is fine. */
  .desktop-wordmark {
    position: absolute;
    right: 3vw;
    bottom: 5vw;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(160px, 16vw, 420px);
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: var(--color-champagne);
    opacity: 0.12;
    pointer-events: none;
    user-select: none;
    transition: opacity 300ms var(--os-ease);
  }
  .desktop-wordmark::before {
    content: attr(data-wordmark);
  }
  .is-expose .desktop-wordmark {
    opacity: 0;
  }
  .desktop-menubar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 40px;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0 0.75rem 0 1rem;
    font-size: 0.8125rem;
    background: color-mix(in srgb, var(--color-panel) 78%, transparent);
    backdrop-filter: blur(18px) saturate(1.2);
    border-bottom: 1px solid var(--color-line);
    z-index: 1000;
  }
  .desktop-menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0 0.65rem;
    border-radius: 8px;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 160ms var(--os-ease);
  }
  .desktop-menu-btn:hover,
  .desktop-menu-btn[aria-pressed='true'] {
    background: color-mix(in srgb, var(--color-champagne) 16%, transparent);
  }
  .desktop-weather {
    padding: 0 0.5rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .desktop-weather[hidden] {
    display: none;
  }
  .desktop-weather-fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .desktop-launcher {
    position: absolute;
    top: 56px;
    left: 20px;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    transition: opacity 250ms var(--os-ease);
  }
  .desktop-launch {
    width: 104px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.3rem;
    border-radius: 14px;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 150ms var(--os-ease);
  }
  .desktop-launch:hover {
    background: color-mix(in srgb, var(--color-champagne) 14%, transparent);
  }
  .desktop-launch:focus-visible .desktop-glyph {
    color: #fff;
  }
  .desktop-launch:focus-visible .desktop-glyph::before {
    opacity: 1;
  }
  .desktop-launch:focus-visible .desktop-glyph::after {
    opacity: 0.5;
  }
  @media (hover: hover) {
    .desktop-launch:hover .desktop-glyph {
      color: #fff;
    }
    .desktop-launch:hover .desktop-glyph::before {
      opacity: 1;
    }
    .desktop-launch:hover .desktop-glyph::after {
      opacity: 0.5;
    }
  }
  .desktop-launch:active .desktop-glyph {
    transform: scale(0.94);
  }
  .desktop-glyph {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: linear-gradient(160deg, var(--color-panel), var(--color-tint));
    border: 1px solid var(--color-line);
    color: var(--color-accent);
    box-shadow:
      inset 0 0 0 3px var(--color-panel),
      inset 0 0 0 4px color-mix(in srgb, var(--color-champagne) 35%, transparent),
      var(--shadow-soft);
    transition:
      transform 160ms var(--os-ease),
      color 200ms var(--os-ease);
  }
  @media (height < 720px) {
    .desktop-launcher {
      top: 46px;
      gap: 0.35rem;
    }
    .desktop-launch {
      gap: 0.25rem;
      padding: 0.3rem;
    }
    .desktop-glyph {
      width: 44px;
      height: 44px;
      border-radius: 14px;
    }
  }
  .desktop-window {
    position: absolute;
    display: flex;
    flex-direction: column;
    width: var(--win-w, min(860px, 90vw));
    height: var(--win-h, min(640px, 80vh));
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.6) inset,
      0 44px 90px -36px rgb(94 68 19 / 0.38),
      0 8px 20px -12px rgb(94 68 19 / 0.18);
    outline: none;
    overflow: hidden;
  }
  .desktop-window[hidden] {
    display: none;
  }
  .desktop-window[data-maximized],
  .desktop-window[data-snap] {
    top: 44px !important;
    height: calc(100vh - 44px - 92px) !important;
    border-radius: 10px;
  }
  .desktop-window[data-maximized] {
    left: 8px !important;
    width: calc(100vw - 16px) !important;
  }
  .desktop-window[data-snap='left'] {
    left: 8px !important;
    width: calc(50vw - 12px) !important;
  }
  .desktop-window[data-snap='right'] {
    left: calc(50vw + 4px) !important;
    width: calc(50vw - 12px) !important;
  }
  .desktop-snap {
    position: absolute;
    top: 44px;
    height: calc(100vh - 44px - 92px);
    width: calc(50vw - 12px);
    border: 1px solid var(--color-champagne);
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-champagne) 12%, transparent);
    backdrop-filter: blur(4px);
    pointer-events: none;
    z-index: 900;
  }
  .desktop-snap[hidden] {
    display: none;
  }
  .desktop-titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 44px;
    padding: 0 0.75rem 0 0.5rem;
    border-bottom: 1px solid var(--color-line);
    background: linear-gradient(180deg, var(--color-panel), var(--color-paper));
    cursor: grab;
    user-select: none;
    touch-action: none;
  }
  .desktop-lights {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .desktop-light {
    position: relative;
    display: grid;
    place-items: center;
    width: 30px;
    height: 36px;
    border-radius: 8px;
    cursor: pointer;
  }
  .desktop-light::before {
    content: '';
    grid-area: 1 / 1;
    width: 13px;
    height: 13px;
    border-radius: 999px;
    background: var(--light);
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.22);
    transition: transform 150ms var(--os-ease);
  }
  .desktop-light:hover::before {
    transform: scale(1.1);
  }
  .desktop-light svg {
    grid-area: 1 / 1;
    width: 8px;
    height: 8px;
    fill: none;
    stroke: rgb(0 0 0 / 0.65);
    stroke-width: 1.75;
    stroke-linecap: round;
    opacity: 0.35;
    transition: opacity 150ms var(--os-ease);
  }
  .desktop-lights:hover .desktop-light svg,
  .desktop-light:focus-visible svg {
    opacity: 1;
  }
  .desktop-light.is-close {
    --light: #ff5f57;
  }
  .desktop-light.is-min {
    --light: #febc2e;
  }
  .desktop-light.is-max {
    --light: #28c840;
  }
  .desktop-body {
    flex: 1;
    overflow: auto;
    padding: 2rem;
    background:
      linear-gradient(var(--color-panel) 30%, transparent) center top,
      linear-gradient(transparent, var(--color-panel) 70%) center bottom,
      radial-gradient(farthest-side at 50% 0, color-mix(in srgb, var(--color-champagne) 42%, transparent), transparent) center top,
      radial-gradient(farthest-side at 50% 100%, color-mix(in srgb, var(--color-champagne) 42%, transparent), transparent) center bottom;
    background-repeat: no-repeat;
    background-size: 100% 34px, 100% 34px, 100% 18px, 100% 18px;
    background-attachment: local, local, scroll, scroll;
  }
  /* Exposé */
  .is-expose .desktop-window {
    transition: transform 320ms var(--os-ease);
    cursor: pointer;
  }
  .is-expose .desktop-window > * {
    pointer-events: none;
  }
  .is-expose .desktop-window:hover,
  .is-expose .desktop-window:focus-visible {
    outline: 2.5px solid var(--color-accent);
    outline-offset: 3px;
  }
  .is-expose .desktop-launcher {
    opacity: 0;
  }
  .expose-layer {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: rgb(27 32 48 / 0.16);
    backdrop-filter: blur(8px) saturate(1.1);
  }
  .expose-layer[hidden] {
    display: none;
  }
  .expose-label {
    position: absolute;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--color-panel);
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    transform: translateX(-50%);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
  }
  /* Dock: GPU-composited floating pill tooltip instead of layout width reflow */
  .desktop-dock {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.65rem;
    z-index: 1000;
  }
  .desktop-dock::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 22px;
    background: color-mix(in srgb, var(--color-panel) 72%, transparent);
    backdrop-filter: blur(18px) saturate(1.2);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-lift);
  }
  .desktop-dock-item {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: 15px;
    color: var(--color-accent);
    background: linear-gradient(160deg, var(--color-panel), var(--color-tint));
    border: 1px solid var(--color-line);
    cursor: pointer;
    transition:
      transform 180ms var(--os-ease),
      border-color 180ms var(--os-ease),
      color 180ms var(--os-ease);
  }
  .desktop-dock-icon {
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .desktop-dock-label {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: var(--shadow-soft);
    pointer-events: none;
    opacity: 0;
    transform: translateX(-50%) translateY(6px);
    transition:
      opacity 180ms var(--os-ease),
      transform 180ms var(--os-ease);
  }
  .desktop-dock-item:focus-visible {
    transform: translateY(-3px);
    border-color: transparent;
  }
  .desktop-dock-item:focus-visible .desktop-dock-label {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  @media (hover: hover) {
    .desktop-dock-item:hover {
      transform: translateY(-3px);
      border-color: transparent;
    }
    .desktop-dock-item:hover .desktop-dock-label {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }
  .desktop-dock-dot {
    position: absolute;
    bottom: -6px;
    left: 50%;
    display: none;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-accent);
    transform: translateX(-50%);
  }
  .desktop-dock-item.is-open .desktop-dock-dot {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .desktop::before {
      animation: none;
      will-change: auto;
    }
  }
</style>
