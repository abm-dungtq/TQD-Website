{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Tooling Worker: chat, downloader, Viral Lab, X-ray reports, R2 media and the analytics beacon.
  // The public site and admin now live in EzyPlatform behind `tqd-edge` (edge/wrangler.jsonc); this Worker owns no
  // custom domain route and no cron trigger.
  "name": "tqd-tools",
  "account_id": "b243f38bff984ce1741c379547e97a75",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "CF_ACCOUNT_ID": "b243f38bff984ce1741c379547e97a75",
    "GOCLAW_BASE_URL": "https://goclaw.tqd.io.vn",
    "GOCLAW_AGENT": "dungtq-web",
    "CHAT_DAILY_CAP": "300",
    "DL_BASE_URL": "https://chatbot.abmedu.vn/_tqd_dl",
    "DL_DAILY_CAP": "150",
    "OPENCODE_GO_BASE_URL": "https://opencode.ai/zen/go/v1",
    "OPENCODE_GO_MODEL": "deepseek-v4.1-flash",
    "VIRAL_DAILY_CAP": "150"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tqd_db", "database_id": "b11ff76d-6626-4d05-ab23-34cc124d9163", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tqd-media" }],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "tqd_analytics" }
  ],
  "env": {
    // Preview deploy target allowed by the migration plan; it keeps the same bindings for smoke tests.
    "preview": {
      "name": "tqd-next",
      "workers_dev": true,
      "routes": [],
      "triggers": { "crons": [] },
      "ai": { "binding": "AI", "remote": true },
      "vars": {
        "CF_ACCOUNT_ID": "b243f38bff984ce1741c379547e97a75",
        "GOCLAW_BASE_URL": "https://goclaw.tqd.io.vn",
        "GOCLAW_AGENT": "dungtq-web",
        "CHAT_DAILY_CAP": "300",
        "DL_BASE_URL": "https://chatbot.abmedu.vn/_tqd_dl",
        "DL_DAILY_CAP": "150",
        "OPENCODE_GO_BASE_URL": "https://opencode.ai/zen/go/v1",
        "OPENCODE_GO_MODEL": "deepseek-v4.1-flash",
        "VIRAL_DAILY_CAP": "150"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "tqd_db", "database_id": "b11ff76d-6626-4d05-ab23-34cc124d9163", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tqd-media" }],
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS", "dataset": "tqd_analytics" }
      ]
    }
  }
}
