{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tqd-website",
  "account_id": "b243f38bff984ce1741c379547e97a75",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "tqd.io.vn", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": { "ADMIN_EMAIL": "dungtq.ceo@gmail.com", "GOCLAW_BASE_URL": "https://goclaw.tqd.io.vn", "GOCLAW_AGENT": "dungtq-web", "CHAT_DAILY_CAP": "300" },
  "d1_databases": [
    { "binding": "DB", "database_name": "tqd_db", "database_id": "b11ff76d-6626-4d05-ab23-34cc124d9163", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tqd-media" }],
  "triggers": { "crons": ["0 19 * * *"] },
  "env": {
    // Preview Worker on workers.dev; same data, no domain, no nightly backup.
    "preview": {
      "name": "tqd-next",
      "workers_dev": true,
      "routes": [],
      "triggers": { "crons": [] },
      "vars": { "ADMIN_EMAIL": "dungtq.ceo@gmail.com", "GOCLAW_BASE_URL": "https://goclaw.tqd.io.vn", "GOCLAW_AGENT": "dungtq-web", "CHAT_DAILY_CAP": "300" },
      "d1_databases": [
        { "binding": "DB", "database_name": "tqd_db", "database_id": "b11ff76d-6626-4d05-ab23-34cc124d9163", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tqd-media" }]
    }
  }
}
