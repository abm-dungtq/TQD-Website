---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageActions from '../components/PageActions.astro';
import PageHeading from '../components/PageHeading.astro';
import SectionBody from '../components/SectionBody.astro';
import { isVideoKey, loadSiteData, mediaUrl, SECTION_SEO, type SectionId } from '../lib/content';
import {
  breadcrumbNode,
  collectionPageNode,
  contactPageNode,
  personNode,
  profilePageNode,
  type CollectionItemInput,
} from '../lib/structured-data';

const VALID_SECTIONS = new Set(['ho-so', 'san-pham', 'thu-vien', 'video-ai', 'bai-viet', 'lien-he']);
const requestedSection = Astro.params.section ?? '';
// Reject unknown routes before running D1 queries (CB-11)
if (!VALID_SECTIONS.has(requestedSection)) return Astro.rewrite('/404');

const data = await loadSiteData(env.DB);
const index = data.site.sections.findIndex((x) => x.id === requestedSection);
const s = data.site.sections[index];
if (!s) return Astro.rewrite('/404');

const seo = SECTION_SEO[s.id];
const origin = new URL('/', Astro.url.origin).href;
const url = new URL(`/${s.id}`, Astro.url.origin).href;
const absUrl = (href: string) => (href.startsWith('/') ? new URL(href, Astro.url.origin).href : href);

function buildCollectionItems(sectionId: SectionId): CollectionItemInput[] {
  switch (sectionId) {
    case 'san-pham':
      return [
        ...data.products.map((p) => {
          const preferredHref =
            p.links?.find((l) => l.href.startsWith('/'))?.href ?? p.links?.[0]?.href ?? `/${sectionId}`;
          return {
            name: p.title,
            url: absUrl(preferredHref),
            description: p.summary,
            image: p.coverKey ? absUrl(mediaUrl(p.coverKey)) : undefined,
          };
        }),
        {
          name: 'Tải Video & Mổ Xẻ Kịch Bản Viral AI',
          url: absUrl('/tai-video'),
          description: 'Tải video MP4 chuẩn H.264, tách MP3 320kbps, bóc băng lời thoại (SRT) và viết lại kịch bản chuẩn Viết Pro.',
          image: absUrl('/og/tai-video.png'),
        },
      ];
    case 'video-ai':
      return data.videos.map((v) => {
        const href = v.tiktokId
          ? `https://www.tiktok.com/@abmdungtq/video/${v.tiktokId}`
          : (v.links?.[0]?.href ?? `/${sectionId}`);
        return {
          name: v.title,
          url: absUrl(href),
          description: v.summary,
          image: v.coverKey ? absUrl(mediaUrl(v.coverKey)) : undefined,
        };
      });
    case 'bai-viet':
      return data.articles.map((a) => ({
        name: a.title,
        url: absUrl(`/bai-viet/${a.slug}`),
        description: a.summary || undefined,
        image: a.coverKey ? absUrl(mediaUrl(a.coverKey)) : undefined,
      }));
    case 'thu-vien':
      return (data.site.gallery ?? []).map((g) => ({
        name: g.caption,
        url: absUrl(mediaUrl(g.key)),
        image: isVideoKey(g.key) ? undefined : absUrl(mediaUrl(g.key)),
      }));
    default:
      return [];
  }
}

const breadcrumb = breadcrumbNode(
  [
    { name: 'Trang chủ', url: origin },
    { name: s.title, url },
  ],
  url,
);

const sectionNode =
  s.id === 'ho-so'
    ? profilePageNode(url)
    : s.id === 'lien-he'
      ? contactPageNode(data.site, url, Astro.url.origin)
      : collectionPageNode({
          url,
          origin: Astro.url.origin,
          name: seo.title,
          description: seo.description,
          items: buildCollectionItems(s.id),
        });

const jsonLd = [personNode(data.site, Astro.url.origin), sectionNode, breadcrumb];
---

<BaseLayout
  site={data.site}
  title={seo.title}
  description={seo.description}
  path={`/${s.id}`}
  markdownPath={`/${s.id}.md`}
  ogImagePath={`/og/${s.id}.png`}
  jsonLd={jsonLd}
>
  <PageHeading index={index + 1} label={data.site.person.handle} title={s.title} lede={s.short} />
  <PageActions markdownPath={`/${s.id}.md`} canonicalUrl={url} title={s.title} class="-mt-5 mb-9" />
  <SectionBody id={s.id} data={data} eager headingLevel={2} />
</BaseLayout>
